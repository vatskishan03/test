        Pi.single (138 : Fin 144) (1 : ℤ)) (1 : ℤ) : LaurentPolynomial (Fin 144)) := by
  simp [terminalBClass19NestedRightReduced8] <;> abel

theorem terminalBClass19NestedRightTargetEq8 :
    (∑ k : Fin 8,
      Finsupp.single (terminalBClass19NestedRightReductionUse8 k).targetExponent
      (signedCoefficient (terminalBClass19NestedRightReductionUse8 k).reduction.signExponent
          (terminalBClass19NestedRightReductionUse8 k).coefficient)) = (1 : ℤ) • terminalBClass19NestedRightReduced8 := by
  rw [terminalBClass19NestedRightTargetExplicit8]
  simp [Fin.sum_univ_succ, terminalBClass19NestedRightReductionUse8, signedCoefficient] <;> abel

end

end MonochromaticQuantumGraphs.N8D3
