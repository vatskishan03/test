      tropicalComponentAQuotientRelation8 16 := by
  decide

private theorem tropicalComponentAFactorEdge056_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge056Use8 k).targetExponent
        (signedCoefficient (tropicalComponentAFactorEdge056Use8 k).reduction.signExponent
          (tropicalComponentAFactorEdge056Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (1 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (-1 : ℤ) +
        Pi.single (49 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (1 : ℤ) +
        Pi.single (86 : Fin 144) (1 : ℤ) +
        Pi.single (101 : Fin 144) (1 : ℤ) +
        Pi.single (138 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 32).factorProductPolynomial (tropicalComponentARawFactor8 36)) := by
  decide

