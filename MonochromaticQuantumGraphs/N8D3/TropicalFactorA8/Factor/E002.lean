      tropicalComponentAQuotientRelation8 68 := by
  decide

private theorem tropicalComponentAFactorEdge002_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge002Use8 k).targetExponent
        (signedCoefficient (tropicalComponentAFactorEdge002Use8 k).reduction.signExponent
          (tropicalComponentAFactorEdge002Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (20 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (-1 : ℤ) +
        Pi.single (65 : Fin 144) (1 : ℤ) +
        Pi.single (71 : Fin 144) (1 : ℤ) +
        Pi.single (90 : Fin 144) (1 : ℤ) +
        Pi.single (120 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 0).factorProductPolynomial (tropicalComponentARawFactor8 24)) := by
  decide

