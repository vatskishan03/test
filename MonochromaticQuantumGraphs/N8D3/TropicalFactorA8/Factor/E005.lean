      tropicalComponentAQuotientRelation8 60 := by
  decide

private theorem tropicalComponentAFactorEdge005_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge005Use8 k).targetExponent
