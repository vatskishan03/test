          (tropicalComponentAFactorEdge005Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (0 : Fin 144) (-1 : ℤ) +
        Pi.single (1 : Fin 144) (1 : ℤ) +
        Pi.single (20 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
