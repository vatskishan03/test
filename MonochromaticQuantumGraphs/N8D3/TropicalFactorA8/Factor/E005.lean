        Pi.single (90 : Fin 144) (1 : ℤ) +
        Pi.single (120 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 0).factorProductPolynomial (tropicalComponentARawFactor8 55)) := by
  decide

