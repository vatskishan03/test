      tropicalComponentAQuotientRelation8 43 := by
  decide

private theorem tropicalComponentAFactorEdge016_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge016Use8 k).targetExponent
