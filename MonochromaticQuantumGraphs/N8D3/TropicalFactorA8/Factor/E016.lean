          (tropicalComponentAFactorEdge016Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (26 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (-1 : ℤ) +
        Pi.single (65 : Fin 144) (1 : ℤ) +
        Pi.single (69 : Fin 144) (1 : ℤ) +
        Pi.single (90 : Fin 144) (1 : ℤ) +
        Pi.single (117 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 2).factorProductPolynomial (tropicalComponentARawFactor8 22)) := by
  decide

