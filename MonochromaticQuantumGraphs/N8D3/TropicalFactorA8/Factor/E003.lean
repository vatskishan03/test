      tropicalComponentAQuotientRelation8 47 := by
  decide

private theorem tropicalComponentAFactorEdge003_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge003Use8 k).targetExponent
        (signedCoefficient (tropicalComponentAFactorEdge003Use8 k).reduction.signExponent
          (tropicalComponentAFactorEdge003Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (1 : Fin 144) (1 : ℤ) +
        Pi.single (20 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (69 : Fin 144) (1 : ℤ) +
        Pi.single (89 : Fin 144) (-1 : ℤ) +
        Pi.single (90 : Fin 144) (1 : ℤ) +
        Pi.single (120 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 0).factorProductPolynomial (tropicalComponentARawFactor8 53)) := by
  decide

