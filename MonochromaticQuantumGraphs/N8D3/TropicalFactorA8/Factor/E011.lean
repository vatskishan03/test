private theorem tropicalComponentAFactorEdge011_source_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge011Use8 k).sourceExponent
        (tropicalComponentAFactorEdge011Use8 k).coefficient) =
      tropicalComponentAQuotientRelation8 62 := by
  decide

private theorem tropicalComponentAFactorEdge011_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge011Use8 k).targetExponent
        (signedCoefficient (tropicalComponentAFactorEdge011Use8 k).reduction.signExponent
          (tropicalComponentAFactorEdge011Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (26 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (-1 : ℤ) +
        Pi.single (65 : Fin 144) (1 : ℤ) +
        Pi.single (71 : Fin 144) (1 : ℤ) +
        Pi.single (89 : Fin 144) (1 : ℤ) +
        Pi.single (117 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 1).factorProductPolynomial (tropicalComponentARawFactor8 24)) := by
  decide

/-- Exact Laurent factor certificate for raw edge 11. -/
def tropicalComponentAFactorCertificate8_011 :
    LaurentFactorCertificate (κ := Fin 4) tropicalComponentACharacter8
      (tropicalComponentAQuotientRelation8 62)
      (tropicalComponentARawFactor8 1)
      (tropicalComponentARawFactor8 24) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  shift := (Pi.single (26 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (-1 : ℤ) +
        Pi.single (65 : Fin 144) (1 : ℤ) +
        Pi.single (71 : Fin 144) (1 : ℤ) +
        Pi.single (89 : Fin 144) (1 : ℤ) +
        Pi.single (117 : Fin 144) (1 : ℤ))
  reduction := {
    use := tropicalComponentAFactorEdge011Use8
    source_eq := tropicalComponentAFactorEdge011_source_eq
    target_eq := tropicalComponentAFactorEdge011_target_eq
  }

theorem tropicalComponentARawFactorEdgeProduct8_011
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentARawFactor8 1).factorValue
        (tropicalSupportWeight8 W) *
      (tropicalComponentARawFactor8 24).factorValue
        (tropicalSupportWeight8 W) = 0 :=
  factorValues_mul_eq_zero_of_certificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalComponentAQuotientRelation8 62)
    (tropicalComponentARawFactor8 1)
    (tropicalComponentARawFactor8 24)
    tropicalComponentAFactorCertificate8_011 hChars
    (tropicalComponentAQuotientRelations8_hold hSupport hEq hChars 62)

end

