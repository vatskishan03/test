      tropicalComponentAQuotientRelation8 31 := by
  decide

private theorem tropicalComponentAFactorEdge024_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge024Use8 k).targetExponent
        (signedCoefficient (tropicalComponentAFactorEdge024Use8 k).reduction.signExponent
          (tropicalComponentAFactorEdge024Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (1 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (-1 : ℤ) +
        Pi.single (49 : Fin 144) (1 : ℤ) +
        Pi.single (58 : Fin 144) (1 : ℤ) +
        Pi.single (87 : Fin 144) (1 : ℤ) +
        Pi.single (102 : Fin 144) (1 : ℤ) +
        Pi.single (138 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 4).factorProductPolynomial (tropicalComponentARawFactor8 36)) := by
  decide

