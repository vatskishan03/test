      tropicalComponentAQuotientRelation8 53 := by
  decide

private theorem tropicalComponentAFactorEdge010_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge010Use8 k).targetExponent
        (signedCoefficient (tropicalComponentAFactorEdge010Use8 k).reduction.signExponent
          (tropicalComponentAFactorEdge010Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (26 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (-1 : ℤ) +
        Pi.single (65 : Fin 144) (1 : ℤ) +
        Pi.single (70 : Fin 144) (1 : ℤ) +
        Pi.single (89 : Fin 144) (1 : ℤ) +
        Pi.single (117 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 1).factorProductPolynomial (tropicalComponentARawFactor8 23)) := by
  decide

/-- Exact Laurent factor certificate for raw edge 10. -/
def tropicalComponentAFactorCertificate8_010 :
    LaurentFactorCertificate (κ := Fin 4) tropicalComponentACharacter8
      (tropicalComponentAQuotientRelation8 53)
      (tropicalComponentARawFactor8 1)
      (tropicalComponentARawFactor8 23) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  shift := (Pi.single (26 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (-1 : ℤ) +
        Pi.single (65 : Fin 144) (1 : ℤ) +
        Pi.single (70 : Fin 144) (1 : ℤ) +
        Pi.single (89 : Fin 144) (1 : ℤ) +
        Pi.single (117 : Fin 144) (1 : ℤ))
  reduction := {
    use := tropicalComponentAFactorEdge010Use8
    source_eq := tropicalComponentAFactorEdge010_source_eq
    target_eq := tropicalComponentAFactorEdge010_target_eq
  }

theorem tropicalComponentARawFactorEdgeProduct8_010
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentARawFactor8 1).factorValue
        (tropicalSupportWeight8 W) *
      (tropicalComponentARawFactor8 23).factorValue
        (tropicalSupportWeight8 W) = 0 :=
  factorValues_mul_eq_zero_of_certificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalComponentAQuotientRelation8 53)
    (tropicalComponentARawFactor8 1)
    (tropicalComponentARawFactor8 23)
    tropicalComponentAFactorCertificate8_010 hChars
    (tropicalComponentAQuotientRelations8_hold hSupport hEq hChars 53)

end

