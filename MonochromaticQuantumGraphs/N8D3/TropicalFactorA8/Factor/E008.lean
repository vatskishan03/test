private theorem tropicalComponentAFactorEdge008_source_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge008Use8 k).sourceExponent
        (tropicalComponentAFactorEdge008Use8 k).coefficient) =
      tropicalComponentAQuotientRelation8 49 := by
  decide

private theorem tropicalComponentAFactorEdge008_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge008Use8 k).targetExponent
        (signedCoefficient (tropicalComponentAFactorEdge008Use8 k).reduction.signExponent
          (tropicalComponentAFactorEdge008Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (7 : Fin 144) (1 : ℤ) +
        Pi.single (20 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (69 : Fin 144) (1 : ℤ) +
        Pi.single (89 : Fin 144) (-1 : ℤ) +
        Pi.single (90 : Fin 144) (1 : ℤ) +
        Pi.single (120 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 0).factorProductPolynomial (tropicalComponentARawFactor8 58)) := by
  decide

/-- Exact Laurent factor certificate for raw edge 8. -/
def tropicalComponentAFactorCertificate8_008 :
    LaurentFactorCertificate (κ := Fin 4) tropicalComponentACharacter8
      (tropicalComponentAQuotientRelation8 49)
      (tropicalComponentARawFactor8 0)
      (tropicalComponentARawFactor8 58) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  shift := (Pi.single (7 : Fin 144) (1 : ℤ) +
        Pi.single (20 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (69 : Fin 144) (1 : ℤ) +
        Pi.single (89 : Fin 144) (-1 : ℤ) +
        Pi.single (90 : Fin 144) (1 : ℤ) +
        Pi.single (120 : Fin 144) (1 : ℤ))
  reduction := {
    use := tropicalComponentAFactorEdge008Use8
    source_eq := tropicalComponentAFactorEdge008_source_eq
    target_eq := tropicalComponentAFactorEdge008_target_eq
  }

theorem tropicalComponentARawFactorEdgeProduct8_008
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentARawFactor8 0).factorValue
        (tropicalSupportWeight8 W) *
      (tropicalComponentARawFactor8 58).factorValue
        (tropicalSupportWeight8 W) = 0 :=
  factorValues_mul_eq_zero_of_certificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalComponentAQuotientRelation8 49)
    (tropicalComponentARawFactor8 0)
    (tropicalComponentARawFactor8 58)
    tropicalComponentAFactorCertificate8_008 hChars
    (tropicalComponentAQuotientRelations8_hold hSupport hEq hChars 49)

end

