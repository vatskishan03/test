          (tropicalComponentAFactorEdge007Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (6 : Fin 144) (1 : ℤ) +
        Pi.single (20 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (69 : Fin 144) (1 : ℤ) +
        Pi.single (89 : Fin 144) (-1 : ℤ) +
        Pi.single (90 : Fin 144) (1 : ℤ) +
        Pi.single (120 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 0).factorProductPolynomial (tropicalComponentARawFactor8 57)) := by
  decide

