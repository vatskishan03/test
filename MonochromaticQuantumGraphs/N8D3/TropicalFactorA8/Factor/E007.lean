      tropicalComponentAQuotientRelation8 45 := by
  decide

private theorem tropicalComponentAFactorEdge007_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge007Use8 k).targetExponent
