    source_eq := tropicalComponentAFactorEdge007_source_eq
    target_eq := tropicalComponentAFactorEdge007_target_eq
  }

theorem tropicalComponentARawFactorEdgeProduct8_007
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentARawFactor8 0).factorValue
        (tropicalSupportWeight8 W) *
      (tropicalComponentARawFactor8 57).factorValue
        (tropicalSupportWeight8 W) = 0 :=
  factorValues_mul_eq_zero_of_certificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalComponentAQuotientRelation8 45)
    (tropicalComponentARawFactor8 0)
    (tropicalComponentARawFactor8 57)
    tropicalComponentAFactorCertificate8_007 hChars
    (tropicalComponentAQuotientRelations8_hold hSupport hEq hChars 45)

