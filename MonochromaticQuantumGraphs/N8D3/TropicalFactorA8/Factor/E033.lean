      tropicalComponentAQuotientRelation8 35 := by
  decide

private theorem tropicalComponentAFactorEdge033_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge033Use8 k).targetExponent
        (signedCoefficient (tropicalComponentAFactorEdge033Use8 k).reduction.signExponent
          (tropicalComponentAFactorEdge033Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (25 : Fin 144) (1 : ℤ) +
        Pi.single (51 : Fin 144) (1 : ℤ) +
        Pi.single (58 : Fin 144) (-1 : ℤ) +
        Pi.single (64 : Fin 144) (1 : ℤ) +
        Pi.single (71 : Fin 144) (1 : ℤ) +
        Pi.single (86 : Fin 144) (1 : ℤ) +
        Pi.single (116 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 8).factorProductPolynomial (tropicalComponentARawFactor8 35)) := by
  decide

