theorem tropicalComponentARawFactorEdgeProduct8_014
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentARawFactor8 1).factorValue
        (tropicalSupportWeight8 W) *
      (tropicalComponentARawFactor8 48).factorValue
        (tropicalSupportWeight8 W) = 0 :=
  factorValues_mul_eq_zero_of_certificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalComponentAQuotientRelation8 54)
    (tropicalComponentARawFactor8 1)
    (tropicalComponentARawFactor8 48)
    tropicalComponentAFactorCertificate8_014 hChars
    (tropicalComponentAQuotientRelations8_hold hSupport hEq hChars 54)

end

