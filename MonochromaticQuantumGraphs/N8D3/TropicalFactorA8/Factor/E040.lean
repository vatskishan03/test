      tropicalComponentAQuotientRelation8 0 := by
  decide

private theorem tropicalComponentAFactorEdge040_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge040Use8 k).targetExponent
        (signedCoefficient (tropicalComponentAFactorEdge040Use8 k).reduction.signExponent
          (tropicalComponentAFactorEdge040Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (25 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (-1 : ℤ) +
        Pi.single (49 : Fin 144) (1 : ℤ) +
        Pi.single (51 : Fin 144) (1 : ℤ) +
        Pi.single (70 : Fin 144) (1 : ℤ) +
        Pi.single (116 : Fin 144) (1 : ℤ) +
        Pi.single (138 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 13).factorProductPolynomial (tropicalComponentARawFactor8 36)) := by
  decide

/-- Exact Laurent factor certificate for raw edge 40. -/
def tropicalComponentAFactorCertificate8_040 :
    LaurentFactorCertificate (κ := Fin 4) tropicalComponentACharacter8
      (tropicalComponentAQuotientRelation8 0)
      (tropicalComponentARawFactor8 13)
      (tropicalComponentARawFactor8 36) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  shift := (Pi.single (25 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (-1 : ℤ) +
        Pi.single (49 : Fin 144) (1 : ℤ) +
        Pi.single (51 : Fin 144) (1 : ℤ) +
        Pi.single (70 : Fin 144) (1 : ℤ) +
        Pi.single (116 : Fin 144) (1 : ℤ) +
        Pi.single (138 : Fin 144) (1 : ℤ))
  reduction := {
    use := tropicalComponentAFactorEdge040Use8
    source_eq := tropicalComponentAFactorEdge040_source_eq
    target_eq := tropicalComponentAFactorEdge040_target_eq
  }

theorem tropicalComponentARawFactorEdgeProduct8_040
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentARawFactor8 13).factorValue
        (tropicalSupportWeight8 W) *
      (tropicalComponentARawFactor8 36).factorValue
        (tropicalSupportWeight8 W) = 0 :=
  factorValues_mul_eq_zero_of_certificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalComponentAQuotientRelation8 0)
    (tropicalComponentARawFactor8 13)
    (tropicalComponentARawFactor8 36)
    tropicalComponentAFactorCertificate8_040 hChars
    (tropicalComponentAQuotientRelations8_hold hSupport hEq hChars 0)

end

