private theorem tropicalComponentAFactorEdge000_source_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge000Use8 k).sourceExponent
        (tropicalComponentAFactorEdge000Use8 k).coefficient) =
      tropicalComponentAQuotientRelation8 50 := by
  decide

private theorem tropicalComponentAFactorEdge000_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge000Use8 k).targetExponent
        (signedCoefficient (tropicalComponentAFactorEdge000Use8 k).reduction.signExponent
          (tropicalComponentAFactorEdge000Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (20 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (-1 : ℤ) +
        Pi.single (65 : Fin 144) (1 : ℤ) +
        Pi.single (69 : Fin 144) (1 : ℤ) +
        Pi.single (90 : Fin 144) (1 : ℤ) +
        Pi.single (120 : Fin 144) (1 : ℤ)) ((tropicalComponentARawFactor8 0).factorProductPolynomial (tropicalComponentARawFactor8 22)) := by
  decide

/-- Exact Laurent factor certificate for raw edge 0. -/
def tropicalComponentAFactorCertificate8_000 :
    LaurentFactorCertificate (κ := Fin 4) tropicalComponentACharacter8
      (tropicalComponentAQuotientRelation8 50)
      (tropicalComponentARawFactor8 0)
      (tropicalComponentARawFactor8 22) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  shift := (Pi.single (20 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (-1 : ℤ) +
        Pi.single (65 : Fin 144) (1 : ℤ) +
        Pi.single (69 : Fin 144) (1 : ℤ) +
        Pi.single (90 : Fin 144) (1 : ℤ) +
        Pi.single (120 : Fin 144) (1 : ℤ))
  reduction := {
    use := tropicalComponentAFactorEdge000Use8
    source_eq := tropicalComponentAFactorEdge000_source_eq
    target_eq := tropicalComponentAFactorEdge000_target_eq
  }

theorem tropicalComponentARawFactorEdgeProduct8_000
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentARawFactor8 0).factorValue
        (tropicalSupportWeight8 W) *
      (tropicalComponentARawFactor8 22).factorValue
        (tropicalSupportWeight8 W) = 0 :=
  factorValues_mul_eq_zero_of_certificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalComponentAQuotientRelation8 50)
    (tropicalComponentARawFactor8 0)
    (tropicalComponentARawFactor8 22)
    tropicalComponentAFactorCertificate8_000 hChars
    (tropicalComponentAQuotientRelations8_hold hSupport hEq hChars 50)

end

