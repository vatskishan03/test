      tropicalComponentAQuotientRelation8 64 := by
  decide

private theorem tropicalComponentAFactorEdge018_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentAFactorEdge018Use8 k).targetExponent
