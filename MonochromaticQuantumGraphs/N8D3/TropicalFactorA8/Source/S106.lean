private theorem tropicalComponentASourceReduction106_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction106Use8 k).sourceExponent
        (tropicalComponentASourceReduction106Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 106) := by
  decide

private theorem tropicalComponentASourceReduction106_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction106Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction106Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction106Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 106 := by
  decide

