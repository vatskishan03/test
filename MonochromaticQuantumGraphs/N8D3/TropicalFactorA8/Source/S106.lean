      (tropicalComponentAQuotientReducedSource8 106) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction106Use8
    source_eq := tropicalComponentASourceReduction106_source_eq
    target_eq := tropicalComponentASourceReduction106_target_eq
  }

theorem tropicalComponentASourceReduced8_106_hold
