private theorem tropicalComponentASourceReduction064_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction064Use8 k).sourceExponent
        (tropicalComponentASourceReduction064Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 64) := by
  decide

private theorem tropicalComponentASourceReduction064_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction064Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction064Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction064Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 64 := by
  decide

/-- Exact normalized reduction of retained source 64. -/
def tropicalComponentASourceReductionCertificate8_064 :
