private theorem tropicalComponentASourceReduction098_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction098Use8 k).sourceExponent
        (tropicalComponentASourceReduction098Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 98) := by
  decide

private theorem tropicalComponentASourceReduction098_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction098Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction098Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction098Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 98 := by
  decide

/-- Exact normalized reduction of retained source 98. -/
def tropicalComponentASourceReductionCertificate8_098 :
