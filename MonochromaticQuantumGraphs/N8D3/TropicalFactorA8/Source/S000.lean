private theorem tropicalComponentASourceReduction000_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction000Use8 k).sourceExponent
        (tropicalComponentASourceReduction000Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 0) := by
  decide

private theorem tropicalComponentASourceReduction000_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction000Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction000Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction000Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 0 := by
  decide

