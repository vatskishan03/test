  decide

private theorem tropicalComponentASourceReduction054_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction054Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction054Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction054Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 54 := by
  decide

