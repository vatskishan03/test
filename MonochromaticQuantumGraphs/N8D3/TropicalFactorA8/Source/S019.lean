private theorem tropicalComponentASourceReduction019_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction019Use8 k).sourceExponent
        (tropicalComponentASourceReduction019Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 19) := by
  decide

private theorem tropicalComponentASourceReduction019_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction019Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction019Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction019Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 19 := by
  decide

