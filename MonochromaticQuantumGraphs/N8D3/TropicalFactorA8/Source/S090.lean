private theorem tropicalComponentASourceReduction090_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction090Use8 k).sourceExponent
        (tropicalComponentASourceReduction090Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 90) := by
  decide

private theorem tropicalComponentASourceReduction090_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction090Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction090Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction090Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 90 := by
  decide

/-- Exact normalized reduction of retained source 90. -/
def tropicalComponentASourceReductionCertificate8_090 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 90))
      (tropicalComponentAQuotientReducedSource8 90) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction090Use8
    source_eq := tropicalComponentASourceReduction090_source_eq
    target_eq := tropicalComponentASourceReduction090_target_eq
  }

theorem tropicalComponentASourceReduced8_090_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 90).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 90))
    (tropicalComponentAQuotientReducedSource8 90)
    tropicalComponentASourceReductionCertificate8_090 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 90))

