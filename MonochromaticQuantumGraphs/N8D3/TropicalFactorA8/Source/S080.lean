private theorem tropicalComponentASourceReduction080_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction080Use8 k).sourceExponent
        (tropicalComponentASourceReduction080Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 80) := by
  decide

private theorem tropicalComponentASourceReduction080_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction080Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction080Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction080Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 80 := by
  decide

/-- Exact normalized reduction of retained source 80. -/
def tropicalComponentASourceReductionCertificate8_080 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 80))
      (tropicalComponentAQuotientReducedSource8 80) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction080Use8
    source_eq := tropicalComponentASourceReduction080_source_eq
    target_eq := tropicalComponentASourceReduction080_target_eq
  }

theorem tropicalComponentASourceReduced8_080_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 80).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 80))
    (tropicalComponentAQuotientReducedSource8 80)
    tropicalComponentASourceReductionCertificate8_080 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 80))

end

