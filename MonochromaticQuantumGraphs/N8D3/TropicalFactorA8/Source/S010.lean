private theorem tropicalComponentASourceReduction010_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction010Use8 k).sourceExponent
        (tropicalComponentASourceReduction010Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 10) := by
  decide

private theorem tropicalComponentASourceReduction010_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction010Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction010Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction010Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 10 := by
  decide

/-- Exact normalized reduction of retained source 10. -/
def tropicalComponentASourceReductionCertificate8_010 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 10))
      (tropicalComponentAQuotientReducedSource8 10) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction010Use8
    source_eq := tropicalComponentASourceReduction010_source_eq
    target_eq := tropicalComponentASourceReduction010_target_eq
  }

theorem tropicalComponentASourceReduced8_010_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 10).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 10))
    (tropicalComponentAQuotientReducedSource8 10)
    tropicalComponentASourceReductionCertificate8_010 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 10))

end

