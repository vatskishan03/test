private theorem tropicalComponentASourceReduction021_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction021Use8 k).sourceExponent
        (tropicalComponentASourceReduction021Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 21) := by
  decide

private theorem tropicalComponentASourceReduction021_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction021Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction021Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction021Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 21 := by
  decide

/-- Exact normalized reduction of retained source 21. -/
def tropicalComponentASourceReductionCertificate8_021 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 21))
      (tropicalComponentAQuotientReducedSource8 21) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction021Use8
    source_eq := tropicalComponentASourceReduction021_source_eq
    target_eq := tropicalComponentASourceReduction021_target_eq
  }

theorem tropicalComponentASourceReduced8_021_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 21).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 21))
    (tropicalComponentAQuotientReducedSource8 21)
    tropicalComponentASourceReductionCertificate8_021 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 21))

