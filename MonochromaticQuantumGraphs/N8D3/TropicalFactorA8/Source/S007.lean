private theorem tropicalComponentASourceReduction007_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction007Use8 k).sourceExponent
        (tropicalComponentASourceReduction007Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 7) := by
  decide

private theorem tropicalComponentASourceReduction007_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction007Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction007Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction007Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 7 := by
  decide

/-- Exact normalized reduction of retained source 7. -/
def tropicalComponentASourceReductionCertificate8_007 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 7))
      (tropicalComponentAQuotientReducedSource8 7) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction007Use8
    source_eq := tropicalComponentASourceReduction007_source_eq
    target_eq := tropicalComponentASourceReduction007_target_eq
  }

theorem tropicalComponentASourceReduced8_007_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 7).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 7))
    (tropicalComponentAQuotientReducedSource8 7)
    tropicalComponentASourceReductionCertificate8_007 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
