private theorem tropicalComponentASourceReduction104_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction104Use8 k).sourceExponent
        (tropicalComponentASourceReduction104Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 104) := by
  decide

private theorem tropicalComponentASourceReduction104_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction104Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction104Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction104Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 104 := by
  decide

/-- Exact normalized reduction of retained source 104. -/
def tropicalComponentASourceReductionCertificate8_104 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 104))
      (tropicalComponentAQuotientReducedSource8 104) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction104Use8
    source_eq := tropicalComponentASourceReduction104_source_eq
    target_eq := tropicalComponentASourceReduction104_target_eq
  }

theorem tropicalComponentASourceReduced8_104_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 104).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 104))
    (tropicalComponentAQuotientReducedSource8 104)
    tropicalComponentASourceReductionCertificate8_104 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 104))

