private theorem tropicalComponentASourceReduction041_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction041Use8 k).sourceExponent
        (tropicalComponentASourceReduction041Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 41) := by
  decide

private theorem tropicalComponentASourceReduction041_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction041Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction041Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction041Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 41 := by
  decide

/-- Exact normalized reduction of retained source 41. -/
def tropicalComponentASourceReductionCertificate8_041 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 41))
      (tropicalComponentAQuotientReducedSource8 41) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction041Use8
    source_eq := tropicalComponentASourceReduction041_source_eq
    target_eq := tropicalComponentASourceReduction041_target_eq
  }

theorem tropicalComponentASourceReduced8_041_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 41).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 41))
    (tropicalComponentAQuotientReducedSource8 41)
    tropicalComponentASourceReductionCertificate8_041 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 41))

