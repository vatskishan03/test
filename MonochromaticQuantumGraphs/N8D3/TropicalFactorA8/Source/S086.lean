private theorem tropicalComponentASourceReduction086_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction086Use8 k).sourceExponent
        (tropicalComponentASourceReduction086Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 86) := by
  decide

private theorem tropicalComponentASourceReduction086_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction086Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction086Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction086Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 86 := by
  decide

