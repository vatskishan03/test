private theorem tropicalComponentASourceReduction018_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction018Use8 k).sourceExponent
        (tropicalComponentASourceReduction018Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 18) := by
  decide

private theorem tropicalComponentASourceReduction018_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction018Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction018Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction018Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 18 := by
  decide

