  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction018Use8
    source_eq := tropicalComponentASourceReduction018_source_eq
    target_eq := tropicalComponentASourceReduction018_target_eq
  }

