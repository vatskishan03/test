private theorem tropicalComponentASourceReduction071_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction071Use8 k).sourceExponent
        (tropicalComponentASourceReduction071Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 71) := by
  decide

private theorem tropicalComponentASourceReduction071_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction071Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction071Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction071Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 71 := by
  decide

