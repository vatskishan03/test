private theorem tropicalComponentASourceReduction003_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction003Use8 k).sourceExponent
        (tropicalComponentASourceReduction003Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 3) := by
  decide

private theorem tropicalComponentASourceReduction003_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction003Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction003Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction003Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 3 := by
  decide

/-- Exact normalized reduction of retained source 3. -/
def tropicalComponentASourceReductionCertificate8_003 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 3))
      (tropicalComponentAQuotientReducedSource8 3) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction003Use8
    source_eq := tropicalComponentASourceReduction003_source_eq
    target_eq := tropicalComponentASourceReduction003_target_eq
  }

theorem tropicalComponentASourceReduced8_003_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 3).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 3))
    (tropicalComponentAQuotientReducedSource8 3)
    tropicalComponentASourceReductionCertificate8_003 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 3))

end

