private theorem tropicalComponentASourceReduction051_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction051Use8 k).sourceExponent
        (tropicalComponentASourceReduction051Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 51) := by
  decide

private theorem tropicalComponentASourceReduction051_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction051Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction051Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction051Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 51 := by
  decide

