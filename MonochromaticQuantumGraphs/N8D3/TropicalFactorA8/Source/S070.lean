private theorem tropicalComponentASourceReduction070_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction070Use8 k).sourceExponent
        (tropicalComponentASourceReduction070Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 70) := by
  decide

private theorem tropicalComponentASourceReduction070_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction070Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction070Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction070Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 70 := by
  decide

/-- Exact normalized reduction of retained source 70. -/
def tropicalComponentASourceReductionCertificate8_070 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 70))
      (tropicalComponentAQuotientReducedSource8 70) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction070Use8
    source_eq := tropicalComponentASourceReduction070_source_eq
    target_eq := tropicalComponentASourceReduction070_target_eq
  }

theorem tropicalComponentASourceReduced8_070_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 70).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 70))
    (tropicalComponentAQuotientReducedSource8 70)
    tropicalComponentASourceReductionCertificate8_070 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 70))

