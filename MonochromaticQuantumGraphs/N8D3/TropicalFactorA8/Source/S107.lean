private theorem tropicalComponentASourceReduction107_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction107Use8 k).sourceExponent
        (tropicalComponentASourceReduction107Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 107) := by
  decide

private theorem tropicalComponentASourceReduction107_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction107Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction107Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction107Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 107 := by
  decide

/-- Exact normalized reduction of retained source 107. -/
def tropicalComponentASourceReductionCertificate8_107 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 107))
      (tropicalComponentAQuotientReducedSource8 107) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction107Use8
    source_eq := tropicalComponentASourceReduction107_source_eq
    target_eq := tropicalComponentASourceReduction107_target_eq
  }

theorem tropicalComponentASourceReduced8_107_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 107).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 107))
    (tropicalComponentAQuotientReducedSource8 107)
    tropicalComponentASourceReductionCertificate8_107 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 107))

