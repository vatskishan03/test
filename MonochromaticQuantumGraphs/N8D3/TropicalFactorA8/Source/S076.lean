private theorem tropicalComponentASourceReduction076_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction076Use8 k).sourceExponent
        (tropicalComponentASourceReduction076Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 76) := by
  decide

private theorem tropicalComponentASourceReduction076_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction076Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction076Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction076Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 76 := by
  decide

