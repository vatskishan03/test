private theorem tropicalComponentASourceReduction058_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction058Use8 k).sourceExponent
        (tropicalComponentASourceReduction058Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 58) := by
  decide

private theorem tropicalComponentASourceReduction058_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction058Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction058Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction058Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 58 := by
  decide

