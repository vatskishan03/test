private theorem tropicalComponentASourceReduction092_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction092Use8 k).sourceExponent
        (tropicalComponentASourceReduction092Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 92) := by
  decide

private theorem tropicalComponentASourceReduction092_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction092Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction092Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction092Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 92 := by
  decide

/-- Exact normalized reduction of retained source 92. -/
def tropicalComponentASourceReductionCertificate8_092 :
