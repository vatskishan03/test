      (tropicalComponentAQuotientReducedSource8 92) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction092Use8
    source_eq := tropicalComponentASourceReduction092_source_eq
    target_eq := tropicalComponentASourceReduction092_target_eq
  }

theorem tropicalComponentASourceReduced8_092_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
