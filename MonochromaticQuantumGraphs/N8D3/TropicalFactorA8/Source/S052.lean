      (tropicalComponentAQuotientReducedSource8 52) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction052Use8
    source_eq := tropicalComponentASourceReduction052_source_eq
    target_eq := tropicalComponentASourceReduction052_target_eq
  }

theorem tropicalComponentASourceReduced8_052_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 52).Holds
