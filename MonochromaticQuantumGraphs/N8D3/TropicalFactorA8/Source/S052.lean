private theorem tropicalComponentASourceReduction052_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction052Use8 k).sourceExponent
        (tropicalComponentASourceReduction052Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 52) := by
  decide

private theorem tropicalComponentASourceReduction052_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction052Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction052Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction052Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 52 := by
  decide

/-- Exact normalized reduction of retained source 52. -/
def tropicalComponentASourceReductionCertificate8_052 :
