private theorem tropicalComponentASourceReduction008_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction008Use8 k).sourceExponent
        (tropicalComponentASourceReduction008Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 8) := by
  decide

private theorem tropicalComponentASourceReduction008_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction008Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction008Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction008Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 8 := by
  decide

/-- Exact normalized reduction of retained source 8. -/
def tropicalComponentASourceReductionCertificate8_008 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 8))
      (tropicalComponentAQuotientReducedSource8 8) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction008Use8
    source_eq := tropicalComponentASourceReduction008_source_eq
    target_eq := tropicalComponentASourceReduction008_target_eq
  }

theorem tropicalComponentASourceReduced8_008_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 8).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 8))
    (tropicalComponentAQuotientReducedSource8 8)
    tropicalComponentASourceReductionCertificate8_008 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 8))

end

