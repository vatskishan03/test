private theorem tropicalComponentASourceReduction057_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction057Use8 k).sourceExponent
        (tropicalComponentASourceReduction057Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 57) := by
  decide

private theorem tropicalComponentASourceReduction057_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction057Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction057Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction057Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 57 := by
  decide

