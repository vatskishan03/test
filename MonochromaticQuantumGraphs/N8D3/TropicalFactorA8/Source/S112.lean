private theorem tropicalComponentASourceReduction112_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction112Use8 k).sourceExponent
        (tropicalComponentASourceReduction112Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 112) := by
  decide

private theorem tropicalComponentASourceReduction112_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction112Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction112Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction112Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 112 := by
  decide

/-- Exact normalized reduction of retained source 112. -/
def tropicalComponentASourceReductionCertificate8_112 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 112))
      (tropicalComponentAQuotientReducedSource8 112) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction112Use8
    source_eq := tropicalComponentASourceReduction112_source_eq
    target_eq := tropicalComponentASourceReduction112_target_eq
  }

theorem tropicalComponentASourceReduced8_112_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 112).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 112))
    (tropicalComponentAQuotientReducedSource8 112)
    tropicalComponentASourceReductionCertificate8_112 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 112))

end

