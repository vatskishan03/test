private theorem tropicalComponentASourceReduction100_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction100Use8 k).sourceExponent
        (tropicalComponentASourceReduction100Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 100) := by
  decide

private theorem tropicalComponentASourceReduction100_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction100Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction100Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction100Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 100 := by
  decide

/-- Exact normalized reduction of retained source 100. -/
def tropicalComponentASourceReductionCertificate8_100 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 100))
      (tropicalComponentAQuotientReducedSource8 100) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction100Use8
    source_eq := tropicalComponentASourceReduction100_source_eq
    target_eq := tropicalComponentASourceReduction100_target_eq
  }

theorem tropicalComponentASourceReduced8_100_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 100).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 100))
    (tropicalComponentAQuotientReducedSource8 100)
    tropicalComponentASourceReductionCertificate8_100 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 100))

end

