private theorem tropicalComponentASourceReduction067_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction067Use8 k).sourceExponent
        (tropicalComponentASourceReduction067Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 67) := by
  decide

private theorem tropicalComponentASourceReduction067_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction067Use8 k).targetExponent
