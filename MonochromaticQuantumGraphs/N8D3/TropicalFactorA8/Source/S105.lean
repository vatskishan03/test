private theorem tropicalComponentASourceReduction105_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction105Use8 k).sourceExponent
        (tropicalComponentASourceReduction105Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 105) := by
  decide

private theorem tropicalComponentASourceReduction105_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction105Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction105Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction105Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 105 := by
  decide

/-- Exact normalized reduction of retained source 105. -/
def tropicalComponentASourceReductionCertificate8_105 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 105))
      (tropicalComponentAQuotientReducedSource8 105) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction105Use8
    source_eq := tropicalComponentASourceReduction105_source_eq
    target_eq := tropicalComponentASourceReduction105_target_eq
  }

theorem tropicalComponentASourceReduced8_105_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 105).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 105))
    (tropicalComponentAQuotientReducedSource8 105)
    tropicalComponentASourceReductionCertificate8_105 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 105))

