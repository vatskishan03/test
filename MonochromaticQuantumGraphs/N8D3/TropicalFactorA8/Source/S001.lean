private theorem tropicalComponentASourceReduction001_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction001Use8 k).sourceExponent
        (tropicalComponentASourceReduction001Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 1) := by
  decide

private theorem tropicalComponentASourceReduction001_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction001Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction001Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction001Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 1 := by
  decide

/-- Exact normalized reduction of retained source 1. -/
def tropicalComponentASourceReductionCertificate8_001 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 1))
      (tropicalComponentAQuotientReducedSource8 1) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction001Use8
    source_eq := tropicalComponentASourceReduction001_source_eq
    target_eq := tropicalComponentASourceReduction001_target_eq
  }

theorem tropicalComponentASourceReduced8_001_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 1).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 1))
    (tropicalComponentAQuotientReducedSource8 1)
    tropicalComponentASourceReductionCertificate8_001 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 1))

end

