private theorem tropicalComponentASourceReduction040_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction040Use8 k).sourceExponent
        (tropicalComponentASourceReduction040Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 40) := by
  decide

private theorem tropicalComponentASourceReduction040_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction040Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction040Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction040Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 40 := by
  decide

/-- Exact normalized reduction of retained source 40. -/
def tropicalComponentASourceReductionCertificate8_040 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentACharacter8
      (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 40))
      (tropicalComponentAQuotientReducedSource8 40) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentASourceReduction040Use8
    source_eq := tropicalComponentASourceReduction040_source_eq
    target_eq := tropicalComponentASourceReduction040_target_eq
  }

theorem tropicalComponentASourceReduced8_040_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentACharacters8 W) :
    (tropicalComponentAQuotientReducedSource8 40).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentACharacter8
    (tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 40))
    (tropicalComponentAQuotientReducedSource8 40)
    tropicalComponentASourceReductionCertificate8_040 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentAQuotientSourceIndex8 40))

