private theorem tropicalComponentASourceReduction034_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction034Use8 k).sourceExponent
        (tropicalComponentASourceReduction034Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 34) := by
  decide

private theorem tropicalComponentASourceReduction034_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction034Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction034Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction034Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 34 := by
  decide

