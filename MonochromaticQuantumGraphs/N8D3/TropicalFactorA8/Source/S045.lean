private theorem tropicalComponentASourceReduction045_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction045Use8 k).sourceExponent
        (tropicalComponentASourceReduction045Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 45) := by
  decide

private theorem tropicalComponentASourceReduction045_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction045Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction045Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction045Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 45 := by
  decide

