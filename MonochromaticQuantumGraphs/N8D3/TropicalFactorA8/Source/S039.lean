private theorem tropicalComponentASourceReduction039_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction039Use8 k).sourceExponent
        (tropicalComponentASourceReduction039Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 39) := by
  decide

private theorem tropicalComponentASourceReduction039_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction039Use8 k).targetExponent
