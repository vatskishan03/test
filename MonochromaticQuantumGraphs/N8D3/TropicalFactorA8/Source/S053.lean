private theorem tropicalComponentASourceReduction053_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction053Use8 k).sourceExponent
        (tropicalComponentASourceReduction053Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentAQuotientSourceIndex8 53) := by
  decide

private theorem tropicalComponentASourceReduction053_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentASourceReduction053Use8 k).targetExponent
        (signedCoefficient (tropicalComponentASourceReduction053Use8 k).reduction.signExponent
          (tropicalComponentASourceReduction053Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentAQuotientReducedSource8 53 := by
  decide

