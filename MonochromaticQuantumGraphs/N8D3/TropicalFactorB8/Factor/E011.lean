private theorem tropicalComponentBFactorEdge011_source_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentBFactorEdge011Use8 k).sourceExponent
        (tropicalComponentBFactorEdge011Use8 k).coefficient) =
      tropicalComponentBQuotientRelation8 70 := by
  decide

private theorem tropicalComponentBFactorEdge011_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentBFactorEdge011Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBFactorEdge011Use8 k).reduction.signExponent
          (tropicalComponentBFactorEdge011Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (26 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (-1 : ℤ) +
        Pi.single (65 : Fin 144) (1 : ℤ) +
        Pi.single (71 : Fin 144) (1 : ℤ) +
        Pi.single (89 : Fin 144) (1 : ℤ) +
        Pi.single (117 : Fin 144) (1 : ℤ)) ((tropicalComponentBRawFactor8 1).factorProductPolynomial (tropicalComponentBRawFactor8 8)) := by
  decide

/-- Exact Laurent factor certificate for raw edge 11. -/
def tropicalComponentBFactorCertificate8_011 :
    LaurentFactorCertificate (κ := Fin 4) tropicalComponentBCharacter8
      (tropicalComponentBQuotientRelation8 70)
      (tropicalComponentBRawFactor8 1)
      (tropicalComponentBRawFactor8 8) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  shift := (Pi.single (26 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (-1 : ℤ) +
        Pi.single (65 : Fin 144) (1 : ℤ) +
        Pi.single (71 : Fin 144) (1 : ℤ) +
        Pi.single (89 : Fin 144) (1 : ℤ) +
        Pi.single (117 : Fin 144) (1 : ℤ))
  reduction := {
    use := tropicalComponentBFactorEdge011Use8
    source_eq := tropicalComponentBFactorEdge011_source_eq
    target_eq := tropicalComponentBFactorEdge011_target_eq
  }

theorem tropicalComponentBRawFactorEdgeProduct8_011
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBRawFactor8 1).factorValue
        (tropicalSupportWeight8 W) *
      (tropicalComponentBRawFactor8 8).factorValue
        (tropicalSupportWeight8 W) = 0 :=
  factorValues_mul_eq_zero_of_certificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalComponentBQuotientRelation8 70)
    (tropicalComponentBRawFactor8 1)
    (tropicalComponentBRawFactor8 8)
    tropicalComponentBFactorCertificate8_011 hChars
    (tropicalComponentBQuotientRelations8_hold hSupport hEq hChars 70)

end

