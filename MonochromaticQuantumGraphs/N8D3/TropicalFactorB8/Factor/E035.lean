def tropicalComponentBFactorCertificate8_035 :
    LaurentFactorCertificate (κ := Fin 4) tropicalComponentBCharacter8
      (tropicalComponentBQuotientRelation8 24)
      (tropicalComponentBRawFactor8 6)
      (tropicalComponentBRawFactor8 24) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  shift := (Pi.single (17 : Fin 144) (1 : ℤ) +
        Pi.single (51 : Fin 144) (1 : ℤ) +
        Pi.single (69 : Fin 144) (-1 : ℤ) +
        Pi.single (70 : Fin 144) (1 : ℤ) +
        Pi.single (88 : Fin 144) (1 : ℤ) +
        Pi.single (126 : Fin 144) (1 : ℤ) +
        Pi.single (139 : Fin 144) (1 : ℤ))
  reduction := {
    use := tropicalComponentBFactorEdge035Use8
    source_eq := tropicalComponentBFactorEdge035_source_eq
    target_eq := tropicalComponentBFactorEdge035_target_eq
  }

theorem tropicalComponentBRawFactorEdgeProduct8_035
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBRawFactor8 6).factorValue
        (tropicalSupportWeight8 W) *
      (tropicalComponentBRawFactor8 24).factorValue
