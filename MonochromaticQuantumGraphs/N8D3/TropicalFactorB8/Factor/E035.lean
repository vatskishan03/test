      tropicalComponentBQuotientRelation8 24 := by
  decide

private theorem tropicalComponentBFactorEdge035_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentBFactorEdge035Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBFactorEdge035Use8 k).reduction.signExponent
          (tropicalComponentBFactorEdge035Use8 k).coefficient)) =
      (-1 : ℤ) • LaurentPolynomial.translate (Pi.single (17 : Fin 144) (1 : ℤ) +
        Pi.single (51 : Fin 144) (1 : ℤ) +
        Pi.single (69 : Fin 144) (-1 : ℤ) +
        Pi.single (70 : Fin 144) (1 : ℤ) +
        Pi.single (88 : Fin 144) (1 : ℤ) +
        Pi.single (126 : Fin 144) (1 : ℤ) +
        Pi.single (139 : Fin 144) (1 : ℤ)) ((tropicalComponentBRawFactor8 6).factorProductPolynomial (tropicalComponentBRawFactor8 24)) := by
  decide

