      tropicalComponentBQuotientRelation8 41 := by
  decide

private theorem tropicalComponentBFactorEdge025_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentBFactorEdge025Use8 k).targetExponent
