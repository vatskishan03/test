          (tropicalComponentBFactorEdge025Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (19 : Fin 144) (1 : ℤ) +
        Pi.single (51 : Fin 144) (1 : ℤ) +
        Pi.single (58 : Fin 144) (-1 : ℤ) +
