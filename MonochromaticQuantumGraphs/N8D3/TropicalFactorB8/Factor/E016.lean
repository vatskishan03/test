      tropicalComponentBQuotientRelation8 80 := by
  decide

private theorem tropicalComponentBFactorEdge016_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentBFactorEdge016Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBFactorEdge016Use8 k).reduction.signExponent
          (tropicalComponentBFactorEdge016Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (6 : Fin 144) (-1 : ℤ) +
        Pi.single (7 : Fin 144) (1 : ℤ) +
        Pi.single (26 : Fin 144) (1 : ℤ) +
        Pi.single (49 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (-1 : ℤ) +
        Pi.single (65 : Fin 144) (1 : ℤ) +
        Pi.single (69 : Fin 144) (1 : ℤ) +
        Pi.single (89 : Fin 144) (1 : ℤ) +
        Pi.single (117 : Fin 144) (1 : ℤ)) ((tropicalComponentBRawFactor8 1).factorProductPolynomial (tropicalComponentBRawFactor8 31)) := by
  decide

