private theorem tropicalComponentBFactorEdge030_source_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentBFactorEdge030Use8 k).sourceExponent
        (tropicalComponentBFactorEdge030Use8 k).coefficient) =
      tropicalComponentBQuotientRelation8 40 := by
  decide

private theorem tropicalComponentBFactorEdge030_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentBFactorEdge030Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBFactorEdge030Use8 k).reduction.signExponent
          (tropicalComponentBFactorEdge030Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (25 : Fin 144) (1 : ℤ) +
        Pi.single (51 : Fin 144) (1 : ℤ) +
        Pi.single (58 : Fin 144) (-1 : ℤ) +
        Pi.single (64 : Fin 144) (1 : ℤ) +
        Pi.single (71 : Fin 144) (1 : ℤ) +
        Pi.single (87 : Fin 144) (1 : ℤ) +
        Pi.single (116 : Fin 144) (1 : ℤ)) ((tropicalComponentBRawFactor8 5).factorProductPolynomial (tropicalComponentBRawFactor8 10)) := by
  decide

/-- Exact Laurent factor certificate for raw edge 30. -/
def tropicalComponentBFactorCertificate8_030 :
    LaurentFactorCertificate (κ := Fin 4) tropicalComponentBCharacter8
      (tropicalComponentBQuotientRelation8 40)
      (tropicalComponentBRawFactor8 5)
      (tropicalComponentBRawFactor8 10) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  shift := (Pi.single (25 : Fin 144) (1 : ℤ) +
        Pi.single (51 : Fin 144) (1 : ℤ) +
        Pi.single (58 : Fin 144) (-1 : ℤ) +
        Pi.single (64 : Fin 144) (1 : ℤ) +
        Pi.single (71 : Fin 144) (1 : ℤ) +
        Pi.single (87 : Fin 144) (1 : ℤ) +
        Pi.single (116 : Fin 144) (1 : ℤ))
  reduction := {
    use := tropicalComponentBFactorEdge030Use8
    source_eq := tropicalComponentBFactorEdge030_source_eq
    target_eq := tropicalComponentBFactorEdge030_target_eq
  }

theorem tropicalComponentBRawFactorEdgeProduct8_030
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBRawFactor8 5).factorValue
        (tropicalSupportWeight8 W) *
      (tropicalComponentBRawFactor8 10).factorValue
        (tropicalSupportWeight8 W) = 0 :=
  factorValues_mul_eq_zero_of_certificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalComponentBQuotientRelation8 40)
    (tropicalComponentBRawFactor8 5)
    (tropicalComponentBRawFactor8 10)
    tropicalComponentBFactorCertificate8_030 hChars
    (tropicalComponentBQuotientRelations8_hold hSupport hEq hChars 40)

end

