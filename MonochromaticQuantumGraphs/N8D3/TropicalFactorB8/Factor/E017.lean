      tropicalComponentBQuotientRelation8 50 := by
  decide

private theorem tropicalComponentBFactorEdge017_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentBFactorEdge017Use8 k).targetExponent
