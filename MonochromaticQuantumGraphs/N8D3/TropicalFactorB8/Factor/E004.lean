        Pi.single (71 : Fin 144) (1 : ℤ) +
        Pi.single (90 : Fin 144) (1 : ℤ) +
        Pi.single (120 : Fin 144) (1 : ℤ)) ((tropicalComponentBRawFactor8 0).factorProductPolynomial (tropicalComponentBRawFactor8 41)) := by
  decide

