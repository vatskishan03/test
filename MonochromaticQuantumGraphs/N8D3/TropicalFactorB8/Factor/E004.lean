      tropicalComponentBQuotientRelation8 77 := by
  decide

private theorem tropicalComponentBFactorEdge004_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentBFactorEdge004Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBFactorEdge004Use8 k).reduction.signExponent
          (tropicalComponentBFactorEdge004Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (0 : Fin 144) (-1 : ℤ) +
        Pi.single (1 : Fin 144) (1 : ℤ) +
        Pi.single (20 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (59 : Fin 144) (-1 : ℤ) +
