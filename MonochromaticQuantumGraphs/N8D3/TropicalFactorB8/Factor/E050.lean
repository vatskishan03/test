private theorem tropicalComponentBFactorEdge050_source_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentBFactorEdge050Use8 k).sourceExponent
        (tropicalComponentBFactorEdge050Use8 k).coefficient) =
      tropicalComponentBQuotientRelation8 43 := by
  decide

private theorem tropicalComponentBFactorEdge050_target_eq :
    (∑ k : Fin 4,
      Finsupp.single (tropicalComponentBFactorEdge050Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBFactorEdge050Use8 k).reduction.signExponent
          (tropicalComponentBFactorEdge050Use8 k).coefficient)) =
      (1 : ℤ) • LaurentPolynomial.translate (Pi.single (7 : Fin 144) (1 : ℤ) +
        Pi.single (15 : Fin 144) (-1 : ℤ) +
        Pi.single (17 : Fin 144) (1 : ℤ) +
        Pi.single (26 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (69 : Fin 144) (1 : ℤ) +
        Pi.single (117 : Fin 144) (1 : ℤ)) ((tropicalComponentBRawFactor8 15).factorProductPolynomial (tropicalComponentBRawFactor8 27)) := by
  decide

/-- Exact Laurent factor certificate for raw edge 50. -/
def tropicalComponentBFactorCertificate8_050 :
    LaurentFactorCertificate (κ := Fin 4) tropicalComponentBCharacter8
      (tropicalComponentBQuotientRelation8 43)
      (tropicalComponentBRawFactor8 15)
      (tropicalComponentBRawFactor8 27) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  shift := (Pi.single (7 : Fin 144) (1 : ℤ) +
        Pi.single (15 : Fin 144) (-1 : ℤ) +
        Pi.single (17 : Fin 144) (1 : ℤ) +
        Pi.single (26 : Fin 144) (1 : ℤ) +
        Pi.single (48 : Fin 144) (1 : ℤ) +
        Pi.single (69 : Fin 144) (1 : ℤ) +
        Pi.single (117 : Fin 144) (1 : ℤ))
  reduction := {
    use := tropicalComponentBFactorEdge050Use8
    source_eq := tropicalComponentBFactorEdge050_source_eq
    target_eq := tropicalComponentBFactorEdge050_target_eq
  }

theorem tropicalComponentBRawFactorEdgeProduct8_050
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBRawFactor8 15).factorValue
        (tropicalSupportWeight8 W) *
      (tropicalComponentBRawFactor8 27).factorValue
        (tropicalSupportWeight8 W) = 0 :=
  factorValues_mul_eq_zero_of_certificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalComponentBQuotientRelation8 43)
    (tropicalComponentBRawFactor8 15)
    (tropicalComponentBRawFactor8 27)
    tropicalComponentBFactorCertificate8_050 hChars
    (tropicalComponentBQuotientRelations8_hold hSupport hEq hChars 43)

end

