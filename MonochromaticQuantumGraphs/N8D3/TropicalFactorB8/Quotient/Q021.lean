  reduction := {
    use := tropicalComponentBQuotient021ReductionUse8
    source_eq := tropicalComponentBQuotient021_source_eq
    target_eq := tropicalComponentBQuotient021_target_eq
  }

theorem tropicalComponentBQuotientRelation8_021_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
