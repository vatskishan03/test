/-- The two row-local normalized source polynomials. -/
def shiftedSources : Fin 2 → LaurentPolynomial (Fin 144) :=
![
  TropicalFactorB8.Internal.Source040.reduced,
  TropicalFactorB8.Internal.Source062.reduced
]

/-- Exact two-source shifted-combination data. -/
def shiftedUse :
    Fin 2 → LaurentPolynomial.ShiftedUse (Fin 2) (Fin 144) :=
![
  { source := 0,
      scale := (1 : ℤ),
      shift := (Pi.single (126 : Fin 144) (-1 : ℤ) +
        Pi.single (129 : Fin 144) (1 : ℤ)) },
  { source := 1,
      scale := (-1 : ℤ),
      shift := (0 : LaurentExponent (Fin 144)) }
]

