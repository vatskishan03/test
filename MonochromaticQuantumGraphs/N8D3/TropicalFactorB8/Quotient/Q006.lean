  reduction := {
    use := tropicalComponentBQuotient006ReductionUse8
    source_eq := tropicalComponentBQuotient006_source_eq
    target_eq := tropicalComponentBQuotient006_target_eq
  }

theorem tropicalComponentBQuotientRelation8_006_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientRelation8 6).Holds
      (tropicalSupportWeight8 W) := by
  have hintermediate :
      (tropicalComponentBQuotientIntermediate8 6).Holds
        (tropicalSupportWeight8 W) :=
    LaurentPolynomial.holds_of_shiftedCombinationCertificate
      (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
      tropicalComponentBQuotientReducedSource8
      (tropicalComponentBQuotientIntermediate8 6)
      tropicalComponentBQuotientShiftedCertificate8_006
      (tropicalComponentBQuotientReducedSources8_hold hSupport hEq hChars)
  exact holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalComponentBQuotientIntermediate8 6)
    (tropicalComponentBQuotientRelation8 6)
    tropicalComponentBQuotientReductionCertificate8_006
    hChars hintermediate

