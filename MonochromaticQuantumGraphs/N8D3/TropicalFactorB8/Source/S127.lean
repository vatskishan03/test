private theorem tropicalComponentBSourceReduction127_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction127Use8 k).sourceExponent
        (tropicalComponentBSourceReduction127Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 127) := by
  decide

private theorem tropicalComponentBSourceReduction127_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction127Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction127Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction127Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 127 := by
  decide

/-- Exact normalized reduction of retained source 127. -/
def tropicalComponentBSourceReductionCertificate8_127 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 127))
      (tropicalComponentBQuotientReducedSource8 127) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction127Use8
    source_eq := tropicalComponentBSourceReduction127_source_eq
    target_eq := tropicalComponentBSourceReduction127_target_eq
  }

theorem tropicalComponentBSourceReduced8_127_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 127).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 127))
    (tropicalComponentBQuotientReducedSource8 127)
    tropicalComponentBSourceReductionCertificate8_127 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 127))

end

