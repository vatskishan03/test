private theorem tropicalComponentBSourceReduction049_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction049Use8 k).sourceExponent
        (tropicalComponentBSourceReduction049Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 49) := by
  decide

private theorem tropicalComponentBSourceReduction049_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction049Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction049Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction049Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 49 := by
  decide

/-- Exact normalized reduction of retained source 49. -/
def tropicalComponentBSourceReductionCertificate8_049 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 49))
      (tropicalComponentBQuotientReducedSource8 49) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction049Use8
    source_eq := tropicalComponentBSourceReduction049_source_eq
    target_eq := tropicalComponentBSourceReduction049_target_eq
  }

theorem tropicalComponentBSourceReduced8_049_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 49).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 49))
    (tropicalComponentBQuotientReducedSource8 49)
    tropicalComponentBSourceReductionCertificate8_049 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 49))

