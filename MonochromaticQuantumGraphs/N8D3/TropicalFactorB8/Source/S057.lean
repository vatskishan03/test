private theorem tropicalComponentBSourceReduction057_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction057Use8 k).sourceExponent
        (tropicalComponentBSourceReduction057Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 57) := by
  decide

private theorem tropicalComponentBSourceReduction057_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction057Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction057Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction057Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 57 := by
  decide

/-- Exact normalized reduction of retained source 57. -/
def tropicalComponentBSourceReductionCertificate8_057 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 57))
      (tropicalComponentBQuotientReducedSource8 57) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction057Use8
    source_eq := tropicalComponentBSourceReduction057_source_eq
    target_eq := tropicalComponentBSourceReduction057_target_eq
  }

theorem tropicalComponentBSourceReduced8_057_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 57).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 57))
    (tropicalComponentBQuotientReducedSource8 57)
    tropicalComponentBSourceReductionCertificate8_057 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 57))

