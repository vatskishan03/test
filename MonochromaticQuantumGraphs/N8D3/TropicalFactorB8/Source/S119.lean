private theorem tropicalComponentBSourceReduction119_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction119Use8 k).sourceExponent
        (tropicalComponentBSourceReduction119Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 119) := by
  decide

private theorem tropicalComponentBSourceReduction119_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction119Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction119Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction119Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 119 := by
  decide

/-- Exact normalized reduction of retained source 119. -/
def tropicalComponentBSourceReductionCertificate8_119 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 119))
      (tropicalComponentBQuotientReducedSource8 119) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction119Use8
    source_eq := tropicalComponentBSourceReduction119_source_eq
    target_eq := tropicalComponentBSourceReduction119_target_eq
  }

theorem tropicalComponentBSourceReduced8_119_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 119).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 119))
    (tropicalComponentBQuotientReducedSource8 119)
    tropicalComponentBSourceReductionCertificate8_119 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 119))

end

