      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 108))
      (tropicalComponentBQuotientReducedSource8 108) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction108Use8
    source_eq := tropicalComponentBSourceReduction108_source_eq
    target_eq := tropicalComponentBSourceReduction108_target_eq
  }

theorem tropicalComponentBSourceReduced8_108_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
