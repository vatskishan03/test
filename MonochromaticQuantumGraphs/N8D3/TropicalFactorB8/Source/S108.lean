private theorem tropicalComponentBSourceReduction108_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction108Use8 k).sourceExponent
        (tropicalComponentBSourceReduction108Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 108) := by
  decide

private theorem tropicalComponentBSourceReduction108_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction108Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction108Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction108Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 108 := by
  decide

/-- Exact normalized reduction of retained source 108. -/
def tropicalComponentBSourceReductionCertificate8_108 :
