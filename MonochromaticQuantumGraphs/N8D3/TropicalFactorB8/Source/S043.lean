private theorem tropicalComponentBSourceReduction043_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction043Use8 k).sourceExponent
        (tropicalComponentBSourceReduction043Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 43) := by
  decide

private theorem tropicalComponentBSourceReduction043_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction043Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction043Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction043Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 43 := by
  decide

/-- Exact normalized reduction of retained source 43. -/
def tropicalComponentBSourceReductionCertificate8_043 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 43))
      (tropicalComponentBQuotientReducedSource8 43) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction043Use8
    source_eq := tropicalComponentBSourceReduction043_source_eq
    target_eq := tropicalComponentBSourceReduction043_target_eq
  }

theorem tropicalComponentBSourceReduced8_043_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 43).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 43))
    (tropicalComponentBQuotientReducedSource8 43)
    tropicalComponentBSourceReductionCertificate8_043 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 43))

