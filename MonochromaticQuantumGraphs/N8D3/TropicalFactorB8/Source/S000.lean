private theorem tropicalComponentBSourceReduction000_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction000Use8 k).sourceExponent
        (tropicalComponentBSourceReduction000Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 0) := by
  decide

private theorem tropicalComponentBSourceReduction000_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction000Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction000Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction000Use8 k).coefficient)) =
      (1 : ℤ) • tropicalComponentBQuotientReducedSource8 0 := by
  decide

