  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction000Use8
    source_eq := tropicalComponentBSourceReduction000_source_eq
    target_eq := tropicalComponentBSourceReduction000_target_eq
  }

theorem tropicalComponentBSourceReduced8_000_hold
