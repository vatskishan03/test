private theorem tropicalComponentBSourceReduction089_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction089Use8 k).sourceExponent
        (tropicalComponentBSourceReduction089Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 89) := by
  decide

private theorem tropicalComponentBSourceReduction089_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction089Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction089Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction089Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 89 := by
  decide

