private theorem tropicalComponentBSourceReduction018_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction018Use8 k).sourceExponent
        (tropicalComponentBSourceReduction018Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 18) := by
  decide

private theorem tropicalComponentBSourceReduction018_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction018Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction018Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction018Use8 k).coefficient)) =
      (1 : ℤ) • tropicalComponentBQuotientReducedSource8 18 := by
  decide

