private theorem tropicalComponentBSourceReduction059_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction059Use8 k).sourceExponent
        (tropicalComponentBSourceReduction059Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 59) := by
  decide

private theorem tropicalComponentBSourceReduction059_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction059Use8 k).targetExponent
