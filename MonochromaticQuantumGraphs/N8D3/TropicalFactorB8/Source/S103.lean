private theorem tropicalComponentBSourceReduction103_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction103Use8 k).sourceExponent
        (tropicalComponentBSourceReduction103Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 103) := by
  decide

private theorem tropicalComponentBSourceReduction103_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction103Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction103Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction103Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 103 := by
  decide

/-- Exact normalized reduction of retained source 103. -/
def tropicalComponentBSourceReductionCertificate8_103 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 103))
      (tropicalComponentBQuotientReducedSource8 103) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction103Use8
    source_eq := tropicalComponentBSourceReduction103_source_eq
    target_eq := tropicalComponentBSourceReduction103_target_eq
  }

theorem tropicalComponentBSourceReduced8_103_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 103).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 103))
    (tropicalComponentBQuotientReducedSource8 103)
    tropicalComponentBSourceReductionCertificate8_103 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 103))

end

