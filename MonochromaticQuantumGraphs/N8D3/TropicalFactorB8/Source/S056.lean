private theorem tropicalComponentBSourceReduction056_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction056Use8 k).sourceExponent
        (tropicalComponentBSourceReduction056Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 56) := by
  decide

private theorem tropicalComponentBSourceReduction056_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction056Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction056Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction056Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 56 := by
  decide

/-- Exact normalized reduction of retained source 56. -/
def tropicalComponentBSourceReductionCertificate8_056 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 56))
      (tropicalComponentBQuotientReducedSource8 56) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction056Use8
    source_eq := tropicalComponentBSourceReduction056_source_eq
    target_eq := tropicalComponentBSourceReduction056_target_eq
  }

theorem tropicalComponentBSourceReduced8_056_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 56).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 56))
    (tropicalComponentBQuotientReducedSource8 56)
    tropicalComponentBSourceReductionCertificate8_056 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 56))

