private theorem tropicalComponentBSourceReduction042_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction042Use8 k).sourceExponent
        (tropicalComponentBSourceReduction042Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 42) := by
  decide

private theorem tropicalComponentBSourceReduction042_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction042Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction042Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction042Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 42 := by
  decide

/-- Exact normalized reduction of retained source 42. -/
def tropicalComponentBSourceReductionCertificate8_042 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 42))
      (tropicalComponentBQuotientReducedSource8 42) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction042Use8
    source_eq := tropicalComponentBSourceReduction042_source_eq
    target_eq := tropicalComponentBSourceReduction042_target_eq
  }

theorem tropicalComponentBSourceReduced8_042_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 42).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 42))
    (tropicalComponentBQuotientReducedSource8 42)
    tropicalComponentBSourceReductionCertificate8_042 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 42))

end

