private theorem tropicalComponentBSourceReduction037_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction037Use8 k).sourceExponent
        (tropicalComponentBSourceReduction037Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 37) := by
  decide

private theorem tropicalComponentBSourceReduction037_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction037Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction037Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction037Use8 k).coefficient)) =
      (1 : ℤ) • tropicalComponentBQuotientReducedSource8 37 := by
  decide

/-- Exact normalized reduction of retained source 37. -/
def tropicalComponentBSourceReductionCertificate8_037 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 37))
      (tropicalComponentBQuotientReducedSource8 37) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction037Use8
    source_eq := tropicalComponentBSourceReduction037_source_eq
    target_eq := tropicalComponentBSourceReduction037_target_eq
  }

theorem tropicalComponentBSourceReduced8_037_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 37).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 37))
    (tropicalComponentBQuotientReducedSource8 37)
    tropicalComponentBSourceReductionCertificate8_037 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 37))

end

