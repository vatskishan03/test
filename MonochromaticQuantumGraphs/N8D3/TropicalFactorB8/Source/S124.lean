private theorem tropicalComponentBSourceReduction124_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction124Use8 k).sourceExponent
        (tropicalComponentBSourceReduction124Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 124) := by
  decide

private theorem tropicalComponentBSourceReduction124_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction124Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction124Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction124Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 124 := by
  decide

/-- Exact normalized reduction of retained source 124. -/
def tropicalComponentBSourceReductionCertificate8_124 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 124))
      (tropicalComponentBQuotientReducedSource8 124) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction124Use8
    source_eq := tropicalComponentBSourceReduction124_source_eq
    target_eq := tropicalComponentBSourceReduction124_target_eq
  }

theorem tropicalComponentBSourceReduced8_124_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 124).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 124))
    (tropicalComponentBQuotientReducedSource8 124)
    tropicalComponentBSourceReductionCertificate8_124 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 124))

end

