private theorem tropicalComponentBSourceReduction121_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction121Use8 k).sourceExponent
        (tropicalComponentBSourceReduction121Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 121) := by
  decide

private theorem tropicalComponentBSourceReduction121_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction121Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction121Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction121Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 121 := by
  decide

/-- Exact normalized reduction of retained source 121. -/
def tropicalComponentBSourceReductionCertificate8_121 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 121))
      (tropicalComponentBQuotientReducedSource8 121) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction121Use8
    source_eq := tropicalComponentBSourceReduction121_source_eq
    target_eq := tropicalComponentBSourceReduction121_target_eq
  }

theorem tropicalComponentBSourceReduced8_121_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 121).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 121))
    (tropicalComponentBQuotientReducedSource8 121)
    tropicalComponentBSourceReductionCertificate8_121 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 121))

end

