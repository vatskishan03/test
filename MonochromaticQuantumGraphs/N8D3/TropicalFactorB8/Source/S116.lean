private theorem tropicalComponentBSourceReduction116_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction116Use8 k).sourceExponent
        (tropicalComponentBSourceReduction116Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 116) := by
  decide

private theorem tropicalComponentBSourceReduction116_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction116Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction116Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction116Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 116 := by
  decide

/-- Exact normalized reduction of retained source 116. -/
def tropicalComponentBSourceReductionCertificate8_116 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 116))
      (tropicalComponentBQuotientReducedSource8 116) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction116Use8
    source_eq := tropicalComponentBSourceReduction116_source_eq
    target_eq := tropicalComponentBSourceReduction116_target_eq
  }

theorem tropicalComponentBSourceReduced8_116_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 116).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 116))
    (tropicalComponentBQuotientReducedSource8 116)
    tropicalComponentBSourceReductionCertificate8_116 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 116))

end

