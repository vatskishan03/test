private theorem tropicalComponentBSourceReduction076_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction076Use8 k).sourceExponent
        (tropicalComponentBSourceReduction076Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 76) := by
  decide

private theorem tropicalComponentBSourceReduction076_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction076Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction076Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction076Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 76 := by
  decide

/-- Exact normalized reduction of retained source 76. -/
def tropicalComponentBSourceReductionCertificate8_076 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 76))
      (tropicalComponentBQuotientReducedSource8 76) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction076Use8
    source_eq := tropicalComponentBSourceReduction076_source_eq
    target_eq := tropicalComponentBSourceReduction076_target_eq
  }

theorem tropicalComponentBSourceReduced8_076_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 76).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 76))
    (tropicalComponentBQuotientReducedSource8 76)
    tropicalComponentBSourceReductionCertificate8_076 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 76))

