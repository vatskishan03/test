private theorem tropicalComponentBSourceReduction047_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction047Use8 k).sourceExponent
        (tropicalComponentBSourceReduction047Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 47) := by
  decide

private theorem tropicalComponentBSourceReduction047_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction047Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction047Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction047Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 47 := by
  decide

