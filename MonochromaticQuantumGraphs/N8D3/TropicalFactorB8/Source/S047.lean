      (tropicalComponentBQuotientReducedSource8 47) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction047Use8
    source_eq := tropicalComponentBSourceReduction047_source_eq
    target_eq := tropicalComponentBSourceReduction047_target_eq
  }

theorem tropicalComponentBSourceReduced8_047_hold
