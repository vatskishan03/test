      (tropicalComponentBQuotientReducedSource8 136) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction136Use8
    source_eq := tropicalComponentBSourceReduction136_source_eq
    target_eq := tropicalComponentBSourceReduction136_target_eq
  }

theorem tropicalComponentBSourceReduced8_136_hold
