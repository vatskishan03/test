private theorem tropicalComponentBSourceReduction136_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction136Use8 k).sourceExponent
        (tropicalComponentBSourceReduction136Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 136) := by
  decide

private theorem tropicalComponentBSourceReduction136_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction136Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction136Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction136Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 136 := by
  decide

