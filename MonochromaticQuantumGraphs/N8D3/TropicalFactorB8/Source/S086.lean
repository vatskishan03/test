private theorem tropicalComponentBSourceReduction086_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction086Use8 k).sourceExponent
        (tropicalComponentBSourceReduction086Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 86) := by
  decide

private theorem tropicalComponentBSourceReduction086_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction086Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction086Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction086Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 86 := by
  decide

/-- Exact normalized reduction of retained source 86. -/
def tropicalComponentBSourceReductionCertificate8_086 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 86))
      (tropicalComponentBQuotientReducedSource8 86) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction086Use8
    source_eq := tropicalComponentBSourceReduction086_source_eq
    target_eq := tropicalComponentBSourceReduction086_target_eq
  }

theorem tropicalComponentBSourceReduced8_086_hold
