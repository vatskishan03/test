private theorem tropicalComponentBSourceReduction080_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction080Use8 k).sourceExponent
        (tropicalComponentBSourceReduction080Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 80) := by
  decide

private theorem tropicalComponentBSourceReduction080_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction080Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction080Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction080Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 80 := by
  decide

/-- Exact normalized reduction of retained source 80. -/
def tropicalComponentBSourceReductionCertificate8_080 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 80))
      (tropicalComponentBQuotientReducedSource8 80) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction080Use8
    source_eq := tropicalComponentBSourceReduction080_source_eq
    target_eq := tropicalComponentBSourceReduction080_target_eq
  }

theorem tropicalComponentBSourceReduced8_080_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 80).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 80))
    (tropicalComponentBQuotientReducedSource8 80)
    tropicalComponentBSourceReductionCertificate8_080 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 80))

end

