private theorem tropicalComponentBSourceReduction091_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction091Use8 k).sourceExponent
        (tropicalComponentBSourceReduction091Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 91) := by
  decide

private theorem tropicalComponentBSourceReduction091_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction091Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction091Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction091Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 91 := by
  decide

/-- Exact normalized reduction of retained source 91. -/
def tropicalComponentBSourceReductionCertificate8_091 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 91))
      (tropicalComponentBQuotientReducedSource8 91) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction091Use8
    source_eq := tropicalComponentBSourceReduction091_source_eq
    target_eq := tropicalComponentBSourceReduction091_target_eq
  }

theorem tropicalComponentBSourceReduced8_091_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 91).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 91))
    (tropicalComponentBQuotientReducedSource8 91)
    tropicalComponentBSourceReductionCertificate8_091 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 91))

end

