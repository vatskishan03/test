private theorem tropicalComponentBSourceReduction090_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction090Use8 k).sourceExponent
        (tropicalComponentBSourceReduction090Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 90) := by
  decide

private theorem tropicalComponentBSourceReduction090_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction090Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction090Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction090Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 90 := by
  decide

/-- Exact normalized reduction of retained source 90. -/
def tropicalComponentBSourceReductionCertificate8_090 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 90))
      (tropicalComponentBQuotientReducedSource8 90) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction090Use8
    source_eq := tropicalComponentBSourceReduction090_source_eq
    target_eq := tropicalComponentBSourceReduction090_target_eq
  }

theorem tropicalComponentBSourceReduced8_090_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 90).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 90))
    (tropicalComponentBQuotientReducedSource8 90)
    tropicalComponentBSourceReductionCertificate8_090 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 90))

end

