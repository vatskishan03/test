private theorem tropicalComponentBSourceReduction074_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction074Use8 k).sourceExponent
        (tropicalComponentBSourceReduction074Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 74) := by
  decide

private theorem tropicalComponentBSourceReduction074_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction074Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction074Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction074Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 74 := by
  decide

/-- Exact normalized reduction of retained source 74. -/
def tropicalComponentBSourceReductionCertificate8_074 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 74))
      (tropicalComponentBQuotientReducedSource8 74) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction074Use8
    source_eq := tropicalComponentBSourceReduction074_source_eq
    target_eq := tropicalComponentBSourceReduction074_target_eq
  }

theorem tropicalComponentBSourceReduced8_074_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 74).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 74))
    (tropicalComponentBQuotientReducedSource8 74)
    tropicalComponentBSourceReductionCertificate8_074 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 74))

