private theorem tropicalComponentBSourceReduction140_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction140Use8 k).sourceExponent
        (tropicalComponentBSourceReduction140Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 140) := by
  decide

private theorem tropicalComponentBSourceReduction140_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction140Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction140Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction140Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 140 := by
  decide

/-- Exact normalized reduction of retained source 140. -/
def tropicalComponentBSourceReductionCertificate8_140 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 140))
      (tropicalComponentBQuotientReducedSource8 140) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction140Use8
    source_eq := tropicalComponentBSourceReduction140_source_eq
    target_eq := tropicalComponentBSourceReduction140_target_eq
  }

theorem tropicalComponentBSourceReduced8_140_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 140).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 140))
    (tropicalComponentBQuotientReducedSource8 140)
    tropicalComponentBSourceReductionCertificate8_140 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 140))

end

