  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction087Use8
    source_eq := tropicalComponentBSourceReduction087_source_eq
    target_eq := tropicalComponentBSourceReduction087_target_eq
  }

