private theorem tropicalComponentBSourceReduction087_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction087Use8 k).sourceExponent
        (tropicalComponentBSourceReduction087Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 87) := by
  decide

private theorem tropicalComponentBSourceReduction087_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction087Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction087Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction087Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 87 := by
  decide

