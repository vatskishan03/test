private theorem tropicalComponentBSourceReduction105_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction105Use8 k).sourceExponent
        (tropicalComponentBSourceReduction105Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 105) := by
  decide

private theorem tropicalComponentBSourceReduction105_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction105Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction105Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction105Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 105 := by
  decide

/-- Exact normalized reduction of retained source 105. -/
def tropicalComponentBSourceReductionCertificate8_105 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 105))
      (tropicalComponentBQuotientReducedSource8 105) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction105Use8
    source_eq := tropicalComponentBSourceReduction105_source_eq
    target_eq := tropicalComponentBSourceReduction105_target_eq
  }

theorem tropicalComponentBSourceReduced8_105_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 105).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 105))
    (tropicalComponentBQuotientReducedSource8 105)
    tropicalComponentBSourceReductionCertificate8_105 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 105))

