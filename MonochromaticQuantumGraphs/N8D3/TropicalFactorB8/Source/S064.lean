private theorem tropicalComponentBSourceReduction064_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction064Use8 k).sourceExponent
        (tropicalComponentBSourceReduction064Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 64) := by
  decide

private theorem tropicalComponentBSourceReduction064_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction064Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction064Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction064Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 64 := by
  decide

/-- Exact normalized reduction of retained source 64. -/
def tropicalComponentBSourceReductionCertificate8_064 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 64))
      (tropicalComponentBQuotientReducedSource8 64) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction064Use8
    source_eq := tropicalComponentBSourceReduction064_source_eq
    target_eq := tropicalComponentBSourceReduction064_target_eq
  }

theorem tropicalComponentBSourceReduced8_064_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 64).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 64))
    (tropicalComponentBQuotientReducedSource8 64)
    tropicalComponentBSourceReductionCertificate8_064 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 64))

