private theorem tropicalComponentBSourceReduction071_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction071Use8 k).sourceExponent
        (tropicalComponentBSourceReduction071Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 71) := by
  decide

private theorem tropicalComponentBSourceReduction071_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction071Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction071Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction071Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 71 := by
  decide

/-- Exact normalized reduction of retained source 71. -/
def tropicalComponentBSourceReductionCertificate8_071 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 71))
      (tropicalComponentBQuotientReducedSource8 71) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction071Use8
    source_eq := tropicalComponentBSourceReduction071_source_eq
    target_eq := tropicalComponentBSourceReduction071_target_eq
  }

