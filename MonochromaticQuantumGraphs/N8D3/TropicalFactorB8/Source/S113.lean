private theorem tropicalComponentBSourceReduction113_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction113Use8 k).sourceExponent
        (tropicalComponentBSourceReduction113Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 113) := by
  decide

private theorem tropicalComponentBSourceReduction113_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction113Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction113Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction113Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 113 := by
  decide

/-- Exact normalized reduction of retained source 113. -/
def tropicalComponentBSourceReductionCertificate8_113 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 113))
      (tropicalComponentBQuotientReducedSource8 113) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction113Use8
    source_eq := tropicalComponentBSourceReduction113_source_eq
    target_eq := tropicalComponentBSourceReduction113_target_eq
  }

theorem tropicalComponentBSourceReduced8_113_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 113).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 113))
    (tropicalComponentBQuotientReducedSource8 113)
    tropicalComponentBSourceReductionCertificate8_113 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 113))

end

