private theorem tropicalComponentBSourceReduction092_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction092Use8 k).sourceExponent
        (tropicalComponentBSourceReduction092Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 92) := by
  decide

private theorem tropicalComponentBSourceReduction092_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction092Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction092Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction092Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 92 := by
  decide

/-- Exact normalized reduction of retained source 92. -/
def tropicalComponentBSourceReductionCertificate8_092 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 92))
      (tropicalComponentBQuotientReducedSource8 92) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction092Use8
    source_eq := tropicalComponentBSourceReduction092_source_eq
    target_eq := tropicalComponentBSourceReduction092_target_eq
  }

theorem tropicalComponentBSourceReduced8_092_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 92).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 92))
    (tropicalComponentBQuotientReducedSource8 92)
    tropicalComponentBSourceReductionCertificate8_092 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 92))

