private theorem tropicalComponentBSourceReduction084_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction084Use8 k).sourceExponent
        (tropicalComponentBSourceReduction084Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 84) := by
  decide

private theorem tropicalComponentBSourceReduction084_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction084Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction084Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction084Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 84 := by
  decide

/-- Exact normalized reduction of retained source 84. -/
def tropicalComponentBSourceReductionCertificate8_084 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 84))
      (tropicalComponentBQuotientReducedSource8 84) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction084Use8
    source_eq := tropicalComponentBSourceReduction084_source_eq
    target_eq := tropicalComponentBSourceReduction084_target_eq
  }

theorem tropicalComponentBSourceReduced8_084_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 84).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 84))
    (tropicalComponentBQuotientReducedSource8 84)
    tropicalComponentBSourceReductionCertificate8_084 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 84))

end

