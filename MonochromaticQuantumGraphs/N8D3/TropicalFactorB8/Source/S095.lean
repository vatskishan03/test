private theorem tropicalComponentBSourceReduction095_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction095Use8 k).sourceExponent
        (tropicalComponentBSourceReduction095Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 95) := by
  decide

private theorem tropicalComponentBSourceReduction095_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction095Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction095Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction095Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 95 := by
  decide

/-- Exact normalized reduction of retained source 95. -/
def tropicalComponentBSourceReductionCertificate8_095 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 95))
      (tropicalComponentBQuotientReducedSource8 95) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction095Use8
    source_eq := tropicalComponentBSourceReduction095_source_eq
    target_eq := tropicalComponentBSourceReduction095_target_eq
  }

theorem tropicalComponentBSourceReduced8_095_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 95).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 95))
    (tropicalComponentBQuotientReducedSource8 95)
    tropicalComponentBSourceReductionCertificate8_095 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 95))

