private theorem tropicalComponentBSourceReduction045_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction045Use8 k).sourceExponent
        (tropicalComponentBSourceReduction045Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 45) := by
  decide

private theorem tropicalComponentBSourceReduction045_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction045Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction045Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction045Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 45 := by
  decide

/-- Exact normalized reduction of retained source 45. -/
def tropicalComponentBSourceReductionCertificate8_045 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 45))
      (tropicalComponentBQuotientReducedSource8 45) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction045Use8
    source_eq := tropicalComponentBSourceReduction045_source_eq
    target_eq := tropicalComponentBSourceReduction045_target_eq
  }

theorem tropicalComponentBSourceReduced8_045_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 45).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 45))
    (tropicalComponentBQuotientReducedSource8 45)
    tropicalComponentBSourceReductionCertificate8_045 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 45))

end

