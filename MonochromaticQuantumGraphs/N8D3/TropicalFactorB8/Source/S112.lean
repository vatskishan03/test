private theorem tropicalComponentBSourceReduction112_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction112Use8 k).sourceExponent
        (tropicalComponentBSourceReduction112Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 112) := by
  decide

private theorem tropicalComponentBSourceReduction112_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction112Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction112Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction112Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 112 := by
  decide

/-- Exact normalized reduction of retained source 112. -/
def tropicalComponentBSourceReductionCertificate8_112 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 112))
      (tropicalComponentBQuotientReducedSource8 112) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction112Use8
    source_eq := tropicalComponentBSourceReduction112_source_eq
    target_eq := tropicalComponentBSourceReduction112_target_eq
  }

theorem tropicalComponentBSourceReduced8_112_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 112).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 112))
    (tropicalComponentBQuotientReducedSource8 112)
    tropicalComponentBSourceReductionCertificate8_112 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 112))

end

