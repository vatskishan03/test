  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction079Use8
    source_eq := tropicalComponentBSourceReduction079_source_eq
    target_eq := tropicalComponentBSourceReduction079_target_eq
  }

