private theorem tropicalComponentBSourceReduction079_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction079Use8 k).sourceExponent
        (tropicalComponentBSourceReduction079Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 79) := by
  decide

private theorem tropicalComponentBSourceReduction079_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction079Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction079Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction079Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 79 := by
  decide

