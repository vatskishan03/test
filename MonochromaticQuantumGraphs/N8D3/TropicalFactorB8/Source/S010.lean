private theorem tropicalComponentBSourceReduction010_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction010Use8 k).sourceExponent
        (tropicalComponentBSourceReduction010Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 10) := by
  decide

private theorem tropicalComponentBSourceReduction010_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction010Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction010Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction010Use8 k).coefficient)) =
      (1 : ℤ) • tropicalComponentBQuotientReducedSource8 10 := by
  decide

/-- Exact normalized reduction of retained source 10. -/
def tropicalComponentBSourceReductionCertificate8_010 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 10))
      (tropicalComponentBQuotientReducedSource8 10) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction010Use8
    source_eq := tropicalComponentBSourceReduction010_source_eq
    target_eq := tropicalComponentBSourceReduction010_target_eq
  }

theorem tropicalComponentBSourceReduced8_010_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 10).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 10))
    (tropicalComponentBQuotientReducedSource8 10)
    tropicalComponentBSourceReductionCertificate8_010 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 10))

end

