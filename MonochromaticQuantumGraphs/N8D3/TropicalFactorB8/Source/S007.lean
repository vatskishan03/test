      (tropicalComponentBQuotientReducedSource8 7) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction007Use8
    source_eq := tropicalComponentBSourceReduction007_source_eq
    target_eq := tropicalComponentBSourceReduction007_target_eq
  }

