private theorem tropicalComponentBSourceReduction007_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction007Use8 k).sourceExponent
        (tropicalComponentBSourceReduction007Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 7) := by
  decide

private theorem tropicalComponentBSourceReduction007_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction007Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction007Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction007Use8 k).coefficient)) =
      (1 : ℤ) • tropicalComponentBQuotientReducedSource8 7 := by
  decide

