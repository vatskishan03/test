private theorem tropicalComponentBSourceReduction075_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction075Use8 k).sourceExponent
        (tropicalComponentBSourceReduction075Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 75) := by
  decide

private theorem tropicalComponentBSourceReduction075_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction075Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction075Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction075Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 75 := by
  decide

/-- Exact normalized reduction of retained source 75. -/
def tropicalComponentBSourceReductionCertificate8_075 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 75))
      (tropicalComponentBQuotientReducedSource8 75) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction075Use8
    source_eq := tropicalComponentBSourceReduction075_source_eq
    target_eq := tropicalComponentBSourceReduction075_target_eq
  }

theorem tropicalComponentBSourceReduced8_075_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 75).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 75))
    (tropicalComponentBQuotientReducedSource8 75)
    tropicalComponentBSourceReductionCertificate8_075 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 75))

end

