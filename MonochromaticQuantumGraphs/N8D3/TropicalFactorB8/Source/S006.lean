  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction006Use8
    source_eq := tropicalComponentBSourceReduction006_source_eq
    target_eq := tropicalComponentBSourceReduction006_target_eq
  }

