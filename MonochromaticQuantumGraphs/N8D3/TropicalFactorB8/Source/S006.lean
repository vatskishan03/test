private theorem tropicalComponentBSourceReduction006_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction006Use8 k).sourceExponent
        (tropicalComponentBSourceReduction006Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 6) := by
  decide

private theorem tropicalComponentBSourceReduction006_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction006Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction006Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction006Use8 k).coefficient)) =
      (1 : ℤ) • tropicalComponentBQuotientReducedSource8 6 := by
  decide

