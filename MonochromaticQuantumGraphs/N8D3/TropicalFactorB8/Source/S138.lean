private theorem tropicalComponentBSourceReduction138_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction138Use8 k).sourceExponent
        (tropicalComponentBSourceReduction138Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 138) := by
  decide

private theorem tropicalComponentBSourceReduction138_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction138Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction138Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction138Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 138 := by
  decide

