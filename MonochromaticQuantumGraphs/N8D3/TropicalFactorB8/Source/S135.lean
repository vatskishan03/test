private theorem tropicalComponentBSourceReduction135_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction135Use8 k).sourceExponent
        (tropicalComponentBSourceReduction135Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 135) := by
  decide

private theorem tropicalComponentBSourceReduction135_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction135Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction135Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction135Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 135 := by
  decide

/-- Exact normalized reduction of retained source 135. -/
def tropicalComponentBSourceReductionCertificate8_135 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 135))
      (tropicalComponentBQuotientReducedSource8 135) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction135Use8
    source_eq := tropicalComponentBSourceReduction135_source_eq
    target_eq := tropicalComponentBSourceReduction135_target_eq
  }

theorem tropicalComponentBSourceReduced8_135_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 135).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 135))
    (tropicalComponentBQuotientReducedSource8 135)
    tropicalComponentBSourceReductionCertificate8_135 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 135))

end

