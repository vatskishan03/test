private theorem tropicalComponentBSourceReduction022_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction022Use8 k).sourceExponent
        (tropicalComponentBSourceReduction022Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 22) := by
  decide

private theorem tropicalComponentBSourceReduction022_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction022Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction022Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction022Use8 k).coefficient)) =
      (1 : ℤ) • tropicalComponentBQuotientReducedSource8 22 := by
  decide

/-- Exact normalized reduction of retained source 22. -/
def tropicalComponentBSourceReductionCertificate8_022 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 22))
      (tropicalComponentBQuotientReducedSource8 22) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction022Use8
    source_eq := tropicalComponentBSourceReduction022_source_eq
    target_eq := tropicalComponentBSourceReduction022_target_eq
  }

theorem tropicalComponentBSourceReduced8_022_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 22).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 22))
    (tropicalComponentBQuotientReducedSource8 22)
    tropicalComponentBSourceReductionCertificate8_022 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 22))

