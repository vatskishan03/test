private theorem tropicalComponentBSourceReduction044_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction044Use8 k).sourceExponent
        (tropicalComponentBSourceReduction044Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 44) := by
  decide

private theorem tropicalComponentBSourceReduction044_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction044Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction044Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction044Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 44 := by
  decide

/-- Exact normalized reduction of retained source 44. -/
def tropicalComponentBSourceReductionCertificate8_044 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 44))
      (tropicalComponentBQuotientReducedSource8 44) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction044Use8
    source_eq := tropicalComponentBSourceReduction044_source_eq
    target_eq := tropicalComponentBSourceReduction044_target_eq
  }

theorem tropicalComponentBSourceReduced8_044_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 44).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 44))
    (tropicalComponentBQuotientReducedSource8 44)
    tropicalComponentBSourceReductionCertificate8_044 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 44))

end

