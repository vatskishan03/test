private theorem tropicalComponentBSourceReduction131_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction131Use8 k).sourceExponent
        (tropicalComponentBSourceReduction131Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 131) := by
  decide

private theorem tropicalComponentBSourceReduction131_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction131Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction131Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction131Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 131 := by
  decide

/-- Exact normalized reduction of retained source 131. -/
def tropicalComponentBSourceReductionCertificate8_131 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 131))
      (tropicalComponentBQuotientReducedSource8 131) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction131Use8
    source_eq := tropicalComponentBSourceReduction131_source_eq
    target_eq := tropicalComponentBSourceReduction131_target_eq
  }

theorem tropicalComponentBSourceReduced8_131_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 131).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 131))
    (tropicalComponentBQuotientReducedSource8 131)
    tropicalComponentBSourceReductionCertificate8_131 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 131))

end

