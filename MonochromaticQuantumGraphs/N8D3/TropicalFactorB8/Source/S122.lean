private theorem tropicalComponentBSourceReduction122_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction122Use8 k).sourceExponent
        (tropicalComponentBSourceReduction122Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 122) := by
  decide

private theorem tropicalComponentBSourceReduction122_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction122Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction122Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction122Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 122 := by
  decide

/-- Exact normalized reduction of retained source 122. -/
def tropicalComponentBSourceReductionCertificate8_122 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 122))
      (tropicalComponentBQuotientReducedSource8 122) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction122Use8
    source_eq := tropicalComponentBSourceReduction122_source_eq
    target_eq := tropicalComponentBSourceReduction122_target_eq
  }

theorem tropicalComponentBSourceReduced8_122_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 122).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 122))
    (tropicalComponentBQuotientReducedSource8 122)
    tropicalComponentBSourceReductionCertificate8_122 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 122))

end

