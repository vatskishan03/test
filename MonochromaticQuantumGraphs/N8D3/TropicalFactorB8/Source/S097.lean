private theorem tropicalComponentBSourceReduction097_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction097Use8 k).sourceExponent
        (tropicalComponentBSourceReduction097Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 97) := by
  decide

private theorem tropicalComponentBSourceReduction097_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction097Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction097Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction097Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 97 := by
  decide

