  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction097Use8
    source_eq := tropicalComponentBSourceReduction097_source_eq
    target_eq := tropicalComponentBSourceReduction097_target_eq
  }

