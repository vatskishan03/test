private theorem tropicalComponentBSourceReduction015_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction015Use8 k).sourceExponent
        (tropicalComponentBSourceReduction015Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 15) := by
  decide

private theorem tropicalComponentBSourceReduction015_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction015Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction015Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction015Use8 k).coefficient)) =
      (1 : ℤ) • tropicalComponentBQuotientReducedSource8 15 := by
  decide

/-- Exact normalized reduction of retained source 15. -/
def tropicalComponentBSourceReductionCertificate8_015 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 15))
      (tropicalComponentBQuotientReducedSource8 15) where
  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction015Use8
    source_eq := tropicalComponentBSourceReduction015_source_eq
    target_eq := tropicalComponentBSourceReduction015_target_eq
  }

theorem tropicalComponentBSourceReduced8_015_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 15).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 15))
    (tropicalComponentBQuotientReducedSource8 15)
    tropicalComponentBSourceReductionCertificate8_015 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 15))

