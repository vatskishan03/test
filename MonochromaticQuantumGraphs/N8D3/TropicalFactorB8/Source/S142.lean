private theorem tropicalComponentBSourceReduction142_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction142Use8 k).sourceExponent
        (tropicalComponentBSourceReduction142Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 142) := by
  decide

private theorem tropicalComponentBSourceReduction142_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction142Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction142Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction142Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 142 := by
  decide

/-- Exact normalized reduction of retained source 142. -/
def tropicalComponentBSourceReductionCertificate8_142 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 142))
      (tropicalComponentBQuotientReducedSource8 142) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction142Use8
    source_eq := tropicalComponentBSourceReduction142_source_eq
    target_eq := tropicalComponentBSourceReduction142_target_eq
  }

theorem tropicalComponentBSourceReduced8_142_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 142).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 142))
    (tropicalComponentBQuotientReducedSource8 142)
    tropicalComponentBSourceReductionCertificate8_142 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 142))

end

