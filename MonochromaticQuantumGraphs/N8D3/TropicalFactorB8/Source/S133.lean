private theorem tropicalComponentBSourceReduction133_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction133Use8 k).sourceExponent
        (tropicalComponentBSourceReduction133Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 133) := by
  decide

private theorem tropicalComponentBSourceReduction133_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction133Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction133Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction133Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 133 := by
  decide

/-- Exact normalized reduction of retained source 133. -/
def tropicalComponentBSourceReductionCertificate8_133 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 133))
      (tropicalComponentBQuotientReducedSource8 133) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction133Use8
    source_eq := tropicalComponentBSourceReduction133_source_eq
    target_eq := tropicalComponentBSourceReduction133_target_eq
  }

theorem tropicalComponentBSourceReduced8_133_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 133).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 133))
    (tropicalComponentBQuotientReducedSource8 133)
    tropicalComponentBSourceReductionCertificate8_133 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 133))

