private theorem tropicalComponentBSourceReduction072_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction072Use8 k).sourceExponent
        (tropicalComponentBSourceReduction072Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 72) := by
  decide

private theorem tropicalComponentBSourceReduction072_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction072Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction072Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction072Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 72 := by
  decide

/-- Exact normalized reduction of retained source 72. -/
def tropicalComponentBSourceReductionCertificate8_072 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 72))
      (tropicalComponentBQuotientReducedSource8 72) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction072Use8
    source_eq := tropicalComponentBSourceReduction072_source_eq
    target_eq := tropicalComponentBSourceReduction072_target_eq
  }

theorem tropicalComponentBSourceReduced8_072_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 72).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 72))
    (tropicalComponentBQuotientReducedSource8 72)
    tropicalComponentBSourceReductionCertificate8_072 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 72))

