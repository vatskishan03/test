private theorem tropicalComponentBSourceReduction009_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction009Use8 k).sourceExponent
        (tropicalComponentBSourceReduction009Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 9) := by
  decide

private theorem tropicalComponentBSourceReduction009_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction009Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction009Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction009Use8 k).coefficient)) =
      (1 : ℤ) • tropicalComponentBQuotientReducedSource8 9 := by
  decide

