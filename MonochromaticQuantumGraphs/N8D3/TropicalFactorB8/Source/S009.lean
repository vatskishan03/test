  unit := (1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction009Use8
    source_eq := tropicalComponentBSourceReduction009_source_eq
    target_eq := tropicalComponentBSourceReduction009_target_eq
  }

