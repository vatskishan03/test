private theorem tropicalComponentBSourceReduction114_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction114Use8 k).sourceExponent
        (tropicalComponentBSourceReduction114Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 114) := by
  decide

private theorem tropicalComponentBSourceReduction114_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction114Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction114Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction114Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 114 := by
  decide

/-- Exact normalized reduction of retained source 114. -/
def tropicalComponentBSourceReductionCertificate8_114 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 114))
      (tropicalComponentBQuotientReducedSource8 114) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction114Use8
    source_eq := tropicalComponentBSourceReduction114_source_eq
    target_eq := tropicalComponentBSourceReduction114_target_eq
  }

theorem tropicalComponentBSourceReduced8_114_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 114).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 114))
    (tropicalComponentBQuotientReducedSource8 114)
    tropicalComponentBSourceReductionCertificate8_114 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 114))

end

