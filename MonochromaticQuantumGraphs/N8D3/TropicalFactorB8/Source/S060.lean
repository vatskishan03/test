private theorem tropicalComponentBSourceReduction060_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction060Use8 k).sourceExponent
        (tropicalComponentBSourceReduction060Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 60) := by
  decide

private theorem tropicalComponentBSourceReduction060_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction060Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction060Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction060Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 60 := by
  decide

/-- Exact normalized reduction of retained source 60. -/
def tropicalComponentBSourceReductionCertificate8_060 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 60))
      (tropicalComponentBQuotientReducedSource8 60) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction060Use8
    source_eq := tropicalComponentBSourceReduction060_source_eq
    target_eq := tropicalComponentBSourceReduction060_target_eq
  }

theorem tropicalComponentBSourceReduced8_060_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 60).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 60))
    (tropicalComponentBQuotientReducedSource8 60)
    tropicalComponentBSourceReductionCertificate8_060 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 60))

end

