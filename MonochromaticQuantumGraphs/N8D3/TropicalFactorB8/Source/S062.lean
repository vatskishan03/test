private theorem tropicalComponentBSourceReduction062_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction062Use8 k).sourceExponent
        (tropicalComponentBSourceReduction062Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 62) := by
  decide

private theorem tropicalComponentBSourceReduction062_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction062Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction062Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction062Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 62 := by
  decide

/-- Exact normalized reduction of retained source 62. -/
def tropicalComponentBSourceReductionCertificate8_062 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 62))
      (tropicalComponentBQuotientReducedSource8 62) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction062Use8
    source_eq := tropicalComponentBSourceReduction062_source_eq
    target_eq := tropicalComponentBSourceReduction062_target_eq
  }

theorem tropicalComponentBSourceReduced8_062_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 62).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 62))
    (tropicalComponentBQuotientReducedSource8 62)
    tropicalComponentBSourceReductionCertificate8_062 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 62))

