private theorem tropicalComponentBSourceReduction139_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction139Use8 k).sourceExponent
        (tropicalComponentBSourceReduction139Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 139) := by
  decide

private theorem tropicalComponentBSourceReduction139_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction139Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction139Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction139Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 139 := by
  decide

