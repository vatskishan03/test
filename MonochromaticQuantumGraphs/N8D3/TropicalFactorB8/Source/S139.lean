  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction139Use8
    source_eq := tropicalComponentBSourceReduction139_source_eq
    target_eq := tropicalComponentBSourceReduction139_target_eq
  }

