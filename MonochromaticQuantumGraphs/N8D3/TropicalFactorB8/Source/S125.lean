private theorem tropicalComponentBSourceReduction125_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction125Use8 k).sourceExponent
        (tropicalComponentBSourceReduction125Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 125) := by
  decide

private theorem tropicalComponentBSourceReduction125_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction125Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction125Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction125Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 125 := by
  decide

/-- Exact normalized reduction of retained source 125. -/
def tropicalComponentBSourceReductionCertificate8_125 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 125))
      (tropicalComponentBQuotientReducedSource8 125) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction125Use8
    source_eq := tropicalComponentBSourceReduction125_source_eq
    target_eq := tropicalComponentBSourceReduction125_target_eq
  }

theorem tropicalComponentBSourceReduced8_125_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 125).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 125))
    (tropicalComponentBQuotientReducedSource8 125)
    tropicalComponentBSourceReductionCertificate8_125 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 125))

end

