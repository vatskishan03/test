private theorem tropicalComponentBSourceReduction048_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction048Use8 k).sourceExponent
        (tropicalComponentBSourceReduction048Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 48) := by
  decide

private theorem tropicalComponentBSourceReduction048_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction048Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction048Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction048Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 48 := by
  decide

/-- Exact normalized reduction of retained source 48. -/
def tropicalComponentBSourceReductionCertificate8_048 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 48))
      (tropicalComponentBQuotientReducedSource8 48) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction048Use8
    source_eq := tropicalComponentBSourceReduction048_source_eq
    target_eq := tropicalComponentBSourceReduction048_target_eq
  }

theorem tropicalComponentBSourceReduced8_048_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 48).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 48))
    (tropicalComponentBQuotientReducedSource8 48)
    tropicalComponentBSourceReductionCertificate8_048 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 48))

