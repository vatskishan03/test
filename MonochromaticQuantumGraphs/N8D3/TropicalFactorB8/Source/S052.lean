private theorem tropicalComponentBSourceReduction052_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction052Use8 k).sourceExponent
        (tropicalComponentBSourceReduction052Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 52) := by
  decide

private theorem tropicalComponentBSourceReduction052_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction052Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction052Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction052Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 52 := by
  decide

/-- Exact normalized reduction of retained source 52. -/
def tropicalComponentBSourceReductionCertificate8_052 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 52))
      (tropicalComponentBQuotientReducedSource8 52) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction052Use8
    source_eq := tropicalComponentBSourceReduction052_source_eq
    target_eq := tropicalComponentBSourceReduction052_target_eq
  }

theorem tropicalComponentBSourceReduced8_052_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 52).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 52))
    (tropicalComponentBQuotientReducedSource8 52)
    tropicalComponentBSourceReductionCertificate8_052 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 52))

end

