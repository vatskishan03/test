private theorem tropicalComponentBSourceReduction051_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction051Use8 k).sourceExponent
        (tropicalComponentBSourceReduction051Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 51) := by
  decide

private theorem tropicalComponentBSourceReduction051_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction051Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction051Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction051Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 51 := by
  decide

/-- Exact normalized reduction of retained source 51. -/
def tropicalComponentBSourceReductionCertificate8_051 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 51))
      (tropicalComponentBQuotientReducedSource8 51) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction051Use8
    source_eq := tropicalComponentBSourceReduction051_source_eq
    target_eq := tropicalComponentBSourceReduction051_target_eq
  }

theorem tropicalComponentBSourceReduced8_051_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 51).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 51))
    (tropicalComponentBQuotientReducedSource8 51)
    tropicalComponentBSourceReductionCertificate8_051 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 51))

end

