private theorem tropicalComponentBSourceReduction137_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction137Use8 k).sourceExponent
        (tropicalComponentBSourceReduction137Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 137) := by
  decide

private theorem tropicalComponentBSourceReduction137_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction137Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction137Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction137Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 137 := by
  decide

/-- Exact normalized reduction of retained source 137. -/
def tropicalComponentBSourceReductionCertificate8_137 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 137))
      (tropicalComponentBQuotientReducedSource8 137) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction137Use8
    source_eq := tropicalComponentBSourceReduction137_source_eq
    target_eq := tropicalComponentBSourceReduction137_target_eq
  }

theorem tropicalComponentBSourceReduced8_137_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 137).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 137))
    (tropicalComponentBQuotientReducedSource8 137)
    tropicalComponentBSourceReductionCertificate8_137 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 137))

