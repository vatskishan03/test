private theorem tropicalComponentBSourceReduction054_source_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction054Use8 k).sourceExponent
        (tropicalComponentBSourceReduction054Use8 k).coefficient) = tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 54) := by
  decide

private theorem tropicalComponentBSourceReduction054_target_eq :
    (∑ k : Fin 6,
      Finsupp.single (tropicalComponentBSourceReduction054Use8 k).targetExponent
        (signedCoefficient (tropicalComponentBSourceReduction054Use8 k).reduction.signExponent
          (tropicalComponentBSourceReduction054Use8 k).coefficient)) =
      (-1 : ℤ) • tropicalComponentBQuotientReducedSource8 54 := by
  decide

/-- Exact normalized reduction of retained source 54. -/
def tropicalComponentBSourceReductionCertificate8_054 :
    NormalizedCharacterReductionCertificate (κ := Fin 6)
      tropicalComponentBCharacter8
      (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 54))
      (tropicalComponentBQuotientReducedSource8 54) where
  unit := (-1 : ℤ)
  unit_ne_zero := by norm_num
  reduction := {
    use := tropicalComponentBSourceReduction054Use8
    source_eq := tropicalComponentBSourceReduction054_source_eq
    target_eq := tropicalComponentBSourceReduction054_target_eq
  }

theorem tropicalComponentBSourceReduced8_054_hold
    {W : WeightsN 8 3 ℂ} (hSupport : TropicalExactSupport8 W)
    (hEq : EqSystemN 8 3 W) (hChars : TropicalComponentBCharacters8 W) :
    (tropicalComponentBQuotientReducedSource8 54).Holds
      (tropicalSupportWeight8 W) :=
  holds_of_normalizedCharacterReductionCertificate
    (tropicalSupportWeight8 W) (tropicalSupportWeight8_ne_zero hSupport)
    tropicalComponentBCharacter8
    (tropicalRetainedRelation8 (tropicalComponentBQuotientSourceIndex8 54))
    (tropicalComponentBQuotientReducedSource8 54)
    tropicalComponentBSourceReductionCertificate8_054 hChars
    (tropicalRetainedRelations8_hold hSupport hEq
      (tropicalComponentBQuotientSourceIndex8 54))

